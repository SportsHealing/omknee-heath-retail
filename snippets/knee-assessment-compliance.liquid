{% comment %}
  Knee Assessment Compliance Component
  =====================================
  Reusable block for data processing consent, marketing notice,
  and urgent symptoms disclaimer. Include above the quiz form.
  
  Usage:
  {% render 'knee-assessment-compliance', 
    section_id: section.id,
    privacy_link: '/policies/privacy-policy',
    deletion_link: '/pages/data-deletion-request'
  %}
{% endcomment %}

{%- assign comp_id = section_id | default: 'kac' -%}
{%- assign privacy_url = privacy_link | default: '/policies/privacy-policy' -%}
{%- assign deletion_url = deletion_link | default: '/pages/data-deletion-request' -%}

<style>
/* =====================================================
   COMPLIANCE COMPONENT - Premium Clinical Style
   ===================================================== */
.kac-compliance {
  max-width: 100%;
  font-family: inherit;
}

/* Main consent notice card */
.kac-consent-notice {
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  border: 2px solid #86efac;
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 20px;
}

.kac-consent-notice__header {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

.kac-consent-notice__icon {
  width: 40px;
  height: 40px;
  background: #166534;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.kac-consent-notice__icon svg {
  width: 22px;
  height: 22px;
  color: #fff;
}

.kac-consent-notice__title {
  font-size: 1.0625rem;
  font-weight: 700;
  color: #166534;
  margin: 0;
  line-height: 1.3;
}

.kac-consent-items {
  list-style: none;
  padding: 0;
  margin: 0 0 20px;
}

.kac-consent-items li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 0;
  font-size: 0.9375rem;
  color: #374151;
  line-height: 1.55;
}

.kac-consent-items li:not(:last-child) {
  border-bottom: 1px solid #bbf7d0;
}

.kac-consent-items li svg {
  width: 20px;
  height: 20px;
  color: #16a34a;
  flex-shrink: 0;
  margin-top: 2px;
}

.kac-consent-items .required-highlight {
  background: #fef3c7;
  color: #92400e;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 0.8125rem;
}

.kac-consent-items .optional-highlight {
  background: #e0f2fe;
  color: #0369a1;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 0.8125rem;
}

/* Links row */
.kac-links {
  display: flex;
  flex-wrap: wrap;
  gap: 12px 24px;
  padding-top: 16px;
  border-top: 1px solid #bbf7d0;
}

.kac-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.875rem;
  font-weight: 600;
  color: #166534;
  text-decoration: none;
  padding: 8px 0;
  transition: color 0.2s;
}

.kac-link:hover {
  color: #14532d;
  text-decoration: underline;
}

.kac-link svg {
  width: 16px;
  height: 16px;
}

/* Urgent symptoms warning */
.kac-urgent-warning {
  background: #fef2f2;
  border: 2px solid #fecaca;
  border-radius: 12px;
  padding: 18px 20px;
  display: flex;
  gap: 14px;
  align-items: flex-start;
}

.kac-urgent-warning__icon {
  width: 36px;
  height: 36px;
  background: #dc2626;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.kac-urgent-warning__icon svg {
  width: 20px;
  height: 20px;
  color: #fff;
}

.kac-urgent-warning__content h4 {
  font-size: 0.9375rem;
  font-weight: 700;
  color: #b91c1c;
  margin: 0 0 6px;
}

.kac-urgent-warning__content p {
  font-size: 0.875rem;
  color: #991b1b;
  margin: 0;
  line-height: 1.55;
}

/* Mobile adjustments */
@media (max-width: 480px) {
  .kac-consent-notice {
    padding: 20px 16px;
  }
  
  .kac-consent-notice__header {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  
  .kac-links {
    flex-direction: column;
    gap: 8px;
  }
  
  .kac-urgent-warning {
    padding: 16px;
    flex-direction: column;
    gap: 12px;
  }
}
</style>

<div class="kac-compliance" id="kac-{{ comp_id }}">
  
  <!-- Main Consent Notice Card -->
  <div class="kac-consent-notice">
    <div class="kac-consent-notice__header">
      <div class="kac-consent-notice__icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
      </div>
      <h3 class="kac-consent-notice__title">Before You Begin</h3>
    </div>
    
    <ul class="kac-consent-items">
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/>
        </svg>
        <span><span class="required-highlight">Required</span> Clinical data processing consent is required to proceed with this assessment.</span>
      </li>
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/>
        </svg>
        <span><span class="optional-highlight">Opt-in only</span> Marketing communications are completely optional. You choose.</span>
      </li>
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/>
        </svg>
        <span>Your answers are used to guide your knee health recommendations and next steps.</span>
      </li>
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4"/>
        </svg>
        <span>You can request access to or deletion of your data at any time.</span>
      </li>
    </ul>
    
    <div class="kac-links">
      <a href="{{ privacy_url }}" class="kac-link" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Privacy Policy
      </a>
      <a href="{{ deletion_url }}" class="kac-link" target="_blank" rel="noopener">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        Request Data Deletion
      </a>
    </div>
  </div>
  
  <!-- Urgent Symptoms Warning -->
  <div class="kac-urgent-warning">
    <div class="kac-urgent-warning__icon">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>
    <div class="kac-urgent-warning__content">
      <h4>Urgent Symptoms Disclaimer</h4>
      <p>If your knee is acutely swollen, hot, red, or you cannot bear weight, please seek urgent medical attention (A&E or GP) rather than completing this questionnaire. This tool is not for emergencies.</p>
    </div>
  </div>
  
</div>
