  <span class="key">"last_name"</span>: <span class="string">"q4_lastName"</span>,
  <span class="key">"dob"</span>: <span class="string">"q5_dob"</span>,
  <span class="key">"email"</span>: <span class="string">"q6_email"</span>,
  <span class="key">"mobile"</span>: <span class="string">"q7_mobile"</span>,
  <span class="key">"postcode"</span>: <span class="string">"q8_postcode"</span>,

  <span class="comment">// ===== CONSENT =====</span>
  <span class="key">"consent_clinical"</span>: <span class="string">"q9_consentClinical"</span>,
  <span class="key">"consent_marketing"</span>: <span class="string">"q10_consentMarketing"</span>,

  <span class="comment">// ===== SYMPTOM DOMAINS (0-10 or 0-5 scales) =====</span>
  <span class="key">"pain"</span>: <span class="string">"q11_pain"</span>,
  <span class="key">"sleep"</span>: <span class="string">"q12_sleep"</span>,
  <span class="key">"swelling"</span>: <span class="string">"q13_swelling"</span>,
  <span class="key">"instability"</span>: <span class="string">"q14_instability"</span>,
  <span class="key">"stiffness"</span>: <span class="string">"q15_stiffness"</span>,
  <span class="key">"stairs"</span>: <span class="string">"q16_stairs"</span>,
  <span class="key">"function"</span>: <span class="string">"q17_function"</span>,

  <span class="comment">// ===== PRIOR KNEE HISTORY =====</span>
  <span class="key">"prior_problem"</span>: <span class="string">"q18_priorProblem"</span>,
  <span class="key">"prior_description"</span>: <span class="string">"q19_priorDescription"</span>,
  <span class="key">"treatments"</span>: <span class="string">"q20_treatments"</span>,
  <span class="key">"injection_type"</span>: <span class="string">"q21_injectionType"</span>,
  <span class="key">"surgery_type"</span>: <span class="string">"q22_surgeryType"</span>,
  <span class="key">"treat_helped"</span>: <span class="string">"q23_treatHelped"</span>,
  <span class="key">"treat_duration"</span>: <span class="string">"q24_treatDuration"</span>,
  <span class="key">"treat_stopped"</span>: <span class="string">"q25_treatStopped"</span>,

  <span class="comment">// ===== MEDICAL HISTORY =====</span>
  <span class="key">"pmh"</span>: <span class="string">"q26_pmh"</span>,
  <span class="key">"pmh_other_text"</span>: <span class="string">"q27_pmhOtherText"</span>,
  <span class="key">"trauma_yesno"</span>: <span class="string">"q28_traumaYesno"</span>,
  <span class="key">"trauma_details"</span>: <span class="string">"q29_traumaDetails"</span>,
  <span class="key">"past_surgery_any"</span>: <span class="string">"q30_pastSurgeryAny"</span>,
  <span class="key">"fh_bone_joint"</span>: <span class="string">"q31_fhBoneJoint"</span>,
  <span class="key">"fh_childhood_knee"</span>: <span class="string">"q32_fhChildhoodKnee"</span>,
  <span class="key">"fh_details"</span>: <span class="string">"q33_fhDetails"</span>,

  <span class="comment">// ===== MEDICATIONS & ALLERGIES =====</span>
  <span class="key">"allergies"</span>: <span class="string">"q34_allergies"</span>,
  <span class="key">"meds_list"</span>: <span class="string">"q35_medsList"</span>,
  <span class="key">"meds_flags"</span>: <span class="string">"q36_medsFlags"</span>,

  <span class="comment">// ===== LIFESTYLE =====</span>
  <span class="key">"smoker"</span>: <span class="string">"q37_smoker"</span>,
  <span class="key">"alcohol_yesno"</span>: <span class="string">"q38_alcoholYesno"</span>,
  <span class="key">"alcohol_units"</span>: <span class="string">"q39_alcoholUnits"</span>,
  <span class="key">"other_info"</span>: <span class="string">"q40_otherInfo"</span>,

  <span class="comment">// ===== GOALS & REFERRAL =====</span>
  <span class="key">"expectations"</span>: <span class="string">"q41_expectations"</span>,
  <span class="key">"ref_source"</span>: <span class="string">"q42_refSource"</span>,

  <span class="comment">// ===== UTM TRACKING =====</span>
  <span class="key">"utm_source"</span>: <span class="string">"q43_utmSource"</span>,
  <span class="key">"utm_medium"</span>: <span class="string">"q44_utmMedium"</span>,
  <span class="key">"utm_campaign"</span>: <span class="string">"q45_utmCampaign"</span>
<span class="bracket">}</span></pre>

  <div class="jfp-note">
    <strong>Important:</strong> The <code>qXX_fieldName</code> values above are examples only. 
    You must replace them with your actual Jotform field prefill parameter keys. 
    Remove the comment lines before pasting into Theme Editor (JSON does not support comments).
  </div>

