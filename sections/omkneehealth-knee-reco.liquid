{% comment %}
  OmKneeHealth Knee & Recovery Recommendations Module
  Shopify Section - Pure HTML/CSS/JS, no external dependencies
  Connects to existing Knee Score calculator (Pro Knee, Sleep, Index)
{% endcomment %}

{% schema %}
{
  "name": "Knee Recommendations",
  "tag": "section",
  "class": "knee-reco-section",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Your Personalised Knee & Recovery Recommendations"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Based on your assessment scores and health profile"
    },
    {
      "type": "select",
      "id": "score_source",
      "label": "Primary Score Source",
      "options": [
        { "value": "index", "label": "Index Score (Knee + Sleep average)" },
        { "value": "knee", "label": "Pro Knee Score only" }
      ],
      "default": "index"
    },
    {
      "type": "url",
      "id": "shop_collection_url",
      "label": "Shop Collection URL",
      "default": "/collections/joint-optimisation"
    },
    {
      "type": "url",
      "id": "imaging_booking_url",
      "label": "Imaging Booking URL",
      "default": "https://mykneescan.com"
    },
    {
      "type": "url",
      "id": "clinician_booking_url",
      "label": "Clinician Booking URL",
      "default": "https://sportshealing.com"
    },
    {
      "type": "checkbox",
      "id": "show_rationale",
      "label": "Show Clinical Rationale",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Knee Recommendations",
      "category": "Health"
    }
  ]
}
{% endschema %}

<style>
  .knee-reco-section {
    --kr-bg: #faf9f7;
    --kr-card-bg: #ffffff;
    --kr-text: #1a1a1a;
    --kr-text-muted: #6b7280;
    --kr-border: #e5e5e5;
    --kr-primary: #1e4d3a;
    --kr-primary-hover: #163a2c;
    --kr-accent: #2d5a47;
    
    /* RAG colors */
    --kr-red: #dc2626;
    --kr-red-bg: #fef2f2;
    --kr-red-border: #fecaca;
    --kr-amber: #d97706;
    --kr-amber-bg: #fffbeb;
    --kr-amber-border: #fde68a;
    --kr-lgreen: #65a30d;
    --kr-lgreen-bg: #f7fee7;
    --kr-lgreen-border: #bef264;
    --kr-green: #16a34a;
    --kr-green-bg: #f0fdf4;
    --kr-green-border: #86efac;
    
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: var(--kr-bg);
    padding: 3rem 1rem;
    color: var(--kr-text);
  }
  
  .knee-reco-container {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .knee-reco-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .knee-reco-header h2 {
    font-size: 1.75rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--kr-text);
  }
  
  .knee-reco-header p {
    color: var(--kr-text-muted);
    margin: 0;
  }
  
  /* Score Input Card */
  .kr-input-card {
    background: var(--kr-card-bg);
    border: 1px solid var(--kr-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  .kr-input-card h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .kr-input-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  
  .kr-input-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  
  .kr-input-group label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--kr-text);
  }
  
  .kr-input-group input[type="number"],
  .kr-input-group select {
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--kr-border);
    border-radius: 8px;
    font-size: 1rem;
    background: var(--kr-card-bg);
    color: var(--kr-text);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  
  .kr-input-group input:focus,
  .kr-input-group select:focus {
    outline: none;
    border-color: var(--kr-primary);
    box-shadow: 0 0 0 3px rgba(30, 77, 58, 0.1);
  }
  
  /* Checkbox styling */
  .kr-checkbox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
    margin-top: 1rem;
  }
  
  .kr-checkbox-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: var(--kr-bg);
    border: 1px solid var(--kr-border);
    border-radius: 8px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  
  .kr-checkbox-item:hover {
    border-color: var(--kr-primary);
    background: rgba(30, 77, 58, 0.02);
  }
  
  .kr-checkbox-item.hidden {
    display: none;
  }
  
  .kr-checkbox-item input[type="checkbox"] {
    width: 1.125rem;
    height: 1.125rem;
    accent-color: var(--kr-primary);
    cursor: pointer;
  }
  
  .kr-checkbox-item label {
    font-size: 0.875rem;
    color: var(--kr-text);
    cursor: pointer;
    flex: 1;
  }
  
  /* Score Display */
  .kr-score-display {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    padding: 1.25rem;
    background: var(--kr-card-bg);
    border: 1px solid var(--kr-border);
    border-radius: 12px;
  }
  
  .kr-score-item {
    text-align: center;
  }
  
  .kr-score-value {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
  }
  
  .kr-score-label {
    font-size: 0.75rem;
    color: var(--kr-text-muted);
    margin-top: 0.25rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  /* Band badge */
  .kr-band-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
  }
  
  .kr-band-badge.red { background: var(--kr-red-bg); color: var(--kr-red); border: 1px solid var(--kr-red-border); }
  .kr-band-badge.amber { background: var(--kr-amber-bg); color: var(--kr-amber); border: 1px solid var(--kr-amber-border); }
  .kr-band-badge.lgreen { background: var(--kr-lgreen-bg); color: var(--kr-lgreen); border: 1px solid var(--kr-lgreen-border); }
  .kr-band-badge.green { background: var(--kr-green-bg); color: var(--kr-green); border: 1px solid var(--kr-green-border); }
  
  /* Results Card */
  .kr-results-card {
    background: var(--kr-card-bg);
    border: 1px solid var(--kr-border);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  
  .kr-results-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--kr-border);
  }
  
  .kr-results-header h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--kr-text);
  }
  
  .kr-results-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  
  /* Collapsible sections */
  .kr-collapsible {
    border-bottom: 1px solid var(--kr-border);
  }
  
  .kr-collapsible:last-child {
    border-bottom: none;
  }
  
  .kr-collapsible-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    cursor: pointer;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    font-size: 1rem;
    font-weight: 500;
    color: var(--kr-text);
    transition: background 0.2s;
  }
  
  .kr-collapsible-header:hover {
    background: var(--kr-bg);
  }
  
  .kr-collapsible-header .count {
    background: var(--kr-primary);
    color: white;
    font-size: 0.75rem;
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    margin-left: 0.5rem;
  }
  
  .kr-collapsible-icon {
    transition: transform 0.2s;
  }
  
  .kr-collapsible.open .kr-collapsible-icon {
    transform: rotate(180deg);
  }
  
  .kr-collapsible-content {
    display: none;
    padding: 0 1.5rem 1rem;
  }
  
  .kr-collapsible.open .kr-collapsible-content {
    display: block;
  }
  
  .kr-test-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .kr-test-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.5rem 0;
    font-size: 0.9375rem;
    color: var(--kr-text);
    border-bottom: 1px solid var(--kr-bg);
  }
  
  .kr-test-list li:last-child {
    border-bottom: none;
  }
  
  .kr-test-list li::before {
    content: "✓";
    color: var(--kr-primary);
    font-weight: 600;
    flex-shrink: 0;
  }
  
  /* Notes section */
  .kr-notes {
    padding: 1rem 1.5rem;
    background: var(--kr-bg);
    border-top: 1px solid var(--kr-border);
  }
  
  .kr-notes h4 {
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--kr-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .kr-notes ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .kr-notes li {
    font-size: 0.875rem;
    color: var(--kr-text);
    padding: 0.25rem 0;
    padding-left: 1rem;
    position: relative;
  }
  
  .kr-notes li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--kr-text-muted);
  }
  
  /* Rationale section */
  .kr-rationale {
    padding: 1rem 1.5rem;
    background: rgba(30, 77, 58, 0.03);
    border-top: 1px solid var(--kr-border);
  }
  
  .kr-rationale h4 {
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--kr-primary);
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  
  .kr-rationale p {
    font-size: 0.875rem;
    color: var(--kr-text);
    margin: 0.25rem 0;
    line-height: 1.5;
  }
  
  /* CTA Buttons */
  .kr-cta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  
  .kr-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.25rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    text-align: center;
  }
  
  .kr-cta-btn.primary {
    background: var(--kr-primary);
    color: white;
    border: none;
  }
  
  .kr-cta-btn.primary:hover {
    background: var(--kr-primary-hover);
    transform: translateY(-1px);
  }
  
  .kr-cta-btn.secondary {
    background: var(--kr-card-bg);
    color: var(--kr-primary);
    border: 1px solid var(--kr-primary);
  }
  
  .kr-cta-btn.secondary:hover {
    background: rgba(30, 77, 58, 0.05);
    transform: translateY(-1px);
  }
  
  /* Disclaimer */
  .kr-disclaimer {
    text-align: center;
    padding: 1rem;
    background: var(--kr-bg);
    border: 1px solid var(--kr-border);
    border-radius: 8px;
    font-size: 0.8125rem;
    color: var(--kr-text-muted);
  }
  
  .kr-disclaimer svg {
    vertical-align: middle;
    margin-right: 0.25rem;
  }
  
  /* No score state */
  .kr-no-score {
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--kr-card-bg);
    border: 1px solid var(--kr-border);
    border-radius: 12px;
  }
  
  .kr-no-score svg {
    width: 48px;
    height: 48px;
    color: var(--kr-text-muted);
    margin-bottom: 1rem;
  }
  
  .kr-no-score h3 {
    font-size: 1.125rem;
    margin: 0 0 0.5rem;
  }
  
  .kr-no-score p {
    color: var(--kr-text-muted);
    margin: 0;
  }
  
  /* Generate button */
  .kr-generate-btn {
    display: block;
    width: 100%;
    padding: 1rem;
    background: var(--kr-primary);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    margin-top: 1rem;
  }
  
  .kr-generate-btn:hover {
    background: var(--kr-primary-hover);
    transform: translateY(-1px);
  }
  
  .kr-generate-btn:disabled {
    background: var(--kr-text-muted);
    cursor: not-allowed;
    transform: none;
  }
  
  /* Responsive */
  @media (max-width: 640px) {
    .knee-reco-section {
      padding: 2rem 1rem;
    }
    
    .knee-reco-header h2 {
      font-size: 1.5rem;
    }
    
    .kr-input-grid {
      grid-template-columns: 1fr;
    }
    
    .kr-checkbox-grid {
      grid-template-columns: 1fr;
    }
    
    .kr-score-display {
      flex-direction: column;
      gap: 1rem;
    }
    
    .kr-cta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="knee-reco-container">
  <header class="knee-reco-header">
    <h2>{{ section.settings.section_title }}</h2>
    <p>{{ section.settings.section_subtitle }}</p>
  </header>
  
  <!-- Score Input Section -->
  <div class="kr-input-card" id="kr-score-inputs">
    <h3>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 20V10M18 20V4M6 20v-4"/>
      </svg>
      Enter Your Scores
    </h3>
    <div class="kr-input-grid">
      <div class="kr-input-group">
        <label for="kr-knee-score">Pro Knee Score</label>
        <input type="number" id="kr-knee-score" min="0" max="100" placeholder="0-100">
      </div>
      <div class="kr-input-group">
        <label for="kr-sleep-score">Sleep Score</label>
        <input type="number" id="kr-sleep-score" min="0" max="100" placeholder="0-100">
      </div>
    </div>
  </div>
  
  <!-- Health Profile Section -->
  <div class="kr-input-card" id="kr-health-profile">
    <h3>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
        <circle cx="9" cy="7" r="4"/>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
      </svg>
      Your Health Profile
    </h3>
    <div class="kr-input-grid">
      <div class="kr-input-group">
        <label for="kr-age">Age</label>
        <input type="number" id="kr-age" min="18" max="120" placeholder="Enter your age">
      </div>
      <div class="kr-input-group">
        <label for="kr-sex">Sex</label>
        <select id="kr-sex">
          <option value="">Select...</option>
          <option value="female">Female</option>
          <option value="male">Male</option>
          <option value="other">Other / Prefer not to say</option>
        </select>
      </div>
    </div>
    
    <div class="kr-checkbox-grid">
      <label class="kr-checkbox-item hidden" id="kr-menopause-wrapper">
        <input type="checkbox" id="kr-menopause">
        <label for="kr-menopause">Peri/post-menopausal</label>
      </label>
      <label class="kr-checkbox-item">
        <input type="checkbox" id="kr-cardiac">
        <label for="kr-cardiac">Cardiac history</label>
      </label>
      <label class="kr-checkbox-item">
        <input type="checkbox" id="kr-thyroid">
        <label for="kr-thyroid">Thyroid disease</label>
      </label>
      <label class="kr-checkbox-item">
        <input type="checkbox" id="kr-diabetes">
        <label for="kr-diabetes">Diabetes / metabolic risk</label>
      </label>
    </div>
    
    <button class="kr-generate-btn" id="kr-generate-btn" disabled>
      Generate Recommendations
    </button>
  </div>
  
  <!-- Results Section (hidden initially) -->
  <div id="kr-results-section" style="display: none;">
    <!-- Score Display -->
    <div class="kr-score-display" id="kr-score-display"></div>
    
    <!-- Results Card -->
    <div class="kr-results-card" id="kr-results-card"></div>
    
    <!-- CTA Buttons -->
    <div class="kr-cta-grid">
      <a href="{{ section.settings.shop_collection_url }}" class="kr-cta-btn primary" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        Shop your joint optimisation plan
      </a>
      <a href="{{ section.settings.imaging_booking_url }}" class="kr-cta-btn secondary" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
        Book imaging
      </a>
      <a href="{{ section.settings.clinician_booking_url }}" class="kr-cta-btn secondary" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
        Book a clinician review
      </a>
    </div>
    
    <!-- Disclaimer -->
    <div class="kr-disclaimer">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <line x1="12" y1="16" x2="12" y2="12"/>
        <line x1="12" y1="8" x2="12.01" y2="8"/>
      </svg>
      Educational decision-support, not diagnosis. Always consult a healthcare professional for personalised advice.
    </div>
  </div>
</div>

<script>
(function() {
  'use strict';
  
  // Configuration from Shopify settings
  const CONFIG = {
    scoreSource: '{{ section.settings.score_source | default: "index" }}',
    showRationale: {{ section.settings.show_rationale | default: true }}
  };
  
  // ========== RECOMMENDATION ENGINE ==========
  
  const TESTS = {
    imaging: {
      MRI: "MRI knee (high-resolution, non-contrast)",
      MRI_CONTRAST: "MRI knee with contrast (only if specifically indicated)",
      XR_WB: "Weight-bearing knee X-rays (AP, lateral, Rosenberg, skyline)",
      USS: "Ultrasound knee (effusion/synovitis/Baker's cyst/tendons)",
      DEXA: "DEXA scan (bone density)"
    },
    bloods: {
      CRP: "CRP",
      ESR: "ESR",
      RF: "Rheumatoid factor",
      ANTI_CCP: "Anti-CCP",
      VITD: "25-OH Vitamin D",
      CA_PHOS: "Calcium + Phosphate",
      FERRITIN: "Ferritin",
      TSH_FT4: "TSH ± Free T4",
      HBA1C: "HbA1c",
      LIPIDS: "Lipid profile",
      U_E: "Urea & electrolytes (renal function)"
    },
    procedures: {
      ASPIRATION: "Ultrasound-guided aspiration (if large effusion)"
    }
  };
  
  function kneeBand(score) {
    if (score === null || score === undefined) return { key: "na", label: "—" };
    if (score <= 24) return { key: "red", label: "0–24" };
    if (score <= 49) return { key: "amber", label: "25–49" };
    if (score <= 74) return { key: "lgreen", label: "50–74" };
    return { key: "green", label: "75–100" };
  }
  
  function basePackageByBand(bandKey) {
    switch (bandKey) {
      case "red":
        return {
          imaging: [TESTS.imaging.MRI, TESTS.imaging.XR_WB],
          bloods: [TESTS.bloods.CRP, TESTS.bloods.ESR, TESTS.bloods.VITD],
          procedures: [],
          notes: ["Escalate if red flags or rapid deterioration."],
          rationale: [
            "Low score suggests high symptom burden or instability where diagnosis is important.",
            "MRI characterises menisci/ligaments/cartilage/bone marrow; X-ray assesses alignment and OA."
          ]
        };
      case "amber":
        return {
          imaging: [TESTS.imaging.MRI, TESTS.imaging.USS],
          bloods: [TESTS.bloods.VITD, TESTS.bloods.CRP],
          procedures: [],
          notes: ["Consider weight-bearing X-ray if age >40 or alignment symptoms."],
          rationale: [
            "Moderate limitation often reflects treatable structural pathology and/or inflammation.",
            "Ultrasound is useful for effusion/synovitis/cysts and tendon pain."
          ]
        };
      case "lgreen":
        return {
          imaging: [TESTS.imaging.USS],
          bloods: [TESTS.bloods.VITD],
          procedures: [],
          notes: ["MRI is usually reserved for mechanical symptoms or failed rehab."],
          rationale: [
            "This range often benefits most from optimisation and targeted rehab rather than extensive imaging."
          ]
        };
      case "green":
        return {
          imaging: [],
          bloods: [],
          procedures: [],
          notes: ["Consider baseline ultrasound only for elite sport / prior surgery / reassurance."],
          rationale: [
            "High score suggests good function; focus on prevention and resilience."
          ]
        };
      default:
        return { imaging: [], bloods: [], procedures: [], notes: [], rationale: [] };
    }
  }
  
  function applyModifiers(pkg, ctx) {
    const { age, sex, hasCardiac, hasThyroid, hasDiabetes, isPeriOrPostMenopausal } = ctx;
    
    const addUnique = (arr, item) => { if (item && !arr.includes(item)) arr.push(item); };
    
    // Age rules
    if (age < 30) {
      pkg.notes.push("Age <30: X-ray usually only if trauma or concern for bony injury/alignment.");
    }
    if (age >= 45 && age <= 60) {
      addUnique(pkg.bloods, TESTS.bloods.HBA1C);
      addUnique(pkg.bloods, TESTS.bloods.LIPIDS);
      addUnique(pkg.bloods, TESTS.bloods.TSH_FT4);
      pkg.notes.push("Age 45–60: add metabolic and thyroid screening to support recovery and pain modulation.");
    }
    if (age > 60) {
      addUnique(pkg.bloods, TESTS.bloods.CA_PHOS);
      addUnique(pkg.bloods, TESTS.bloods.U_E);
      addUnique(pkg.imaging, TESTS.imaging.XR_WB);
      pkg.notes.push("Age >60: X-ray + bone/metabolic screening are higher yield; MRI reserved for unclear cases/mechanical symptoms.");
    }
    
    // Sex rules
    if (sex === "female") {
      if (age >= 30) {
        addUnique(pkg.bloods, TESTS.bloods.FERRITIN);
        addUnique(pkg.bloods, TESTS.bloods.TSH_FT4);
        addUnique(pkg.bloods, TESTS.bloods.VITD);
        pkg.notes.push("Female ≥30: check ferritin/thyroid/vitamin D (common contributors to fatigue, pain sensitivity, recovery).");
      }
      if (isPeriOrPostMenopausal) {
        addUnique(pkg.imaging, TESTS.imaging.DEXA);
        addUnique(pkg.bloods, TESTS.bloods.LIPIDS);
        addUnique(pkg.bloods, TESTS.bloods.HBA1C);
        pkg.notes.push("Peri/post-menopause: include bone density and metabolic screening.");
      }
    }
    if (sex === "male") {
      if (age >= 40) {
        addUnique(pkg.bloods, TESTS.bloods.HBA1C);
        addUnique(pkg.bloods, TESTS.bloods.LIPIDS);
        addUnique(pkg.bloods, TESTS.bloods.VITD);
        pkg.notes.push("Male ≥40: add metabolic screening and vitamin D (metabolic OA risk and tendon health).");
      }
    }
    
    // Cardiac history
    if (hasCardiac) {
      addUnique(pkg.bloods, TESTS.bloods.U_E);
      addUnique(pkg.bloods, TESTS.bloods.LIPIDS);
      addUnique(pkg.bloods, TESTS.bloods.HBA1C);
      pkg.notes.push("Cardiac history: prioritise safe exercise prescription; renal function is important before NSAIDs/injections.");
    }
    
    // Thyroid history
    if (hasThyroid) {
      addUnique(pkg.bloods, TESTS.bloods.TSH_FT4);
      pkg.notes.push("Thyroid history: ensure thyroid function is optimised (can affect stiffness, tendons and recovery).");
    }
    
    // Diabetes/metabolic
    if (hasDiabetes) {
      addUnique(pkg.bloods, TESTS.bloods.HBA1C);
      addUnique(pkg.bloods, TESTS.bloods.U_E);
      addUnique(pkg.bloods, TESTS.bloods.CRP);
      pkg.notes.push("Diabetes/metabolic risk: tendon degeneration and slower healing are more common—optimise glucose and consider earlier imaging if mechanical symptoms.");
    }
    
    return pkg;
  }
  
  function applyBandSpecificExtras(pkg, ctx, bandKey) {
    const { age } = ctx;
    const addUnique = (arr, item) => { if (item && !arr.includes(item)) arr.push(item); };
    
    if (bandKey === "red") {
      addUnique(pkg.bloods, TESTS.bloods.RF);
      addUnique(pkg.bloods, TESTS.bloods.ANTI_CCP);
      pkg.notes.push("If significant effusion/synovitis: consider autoimmune screen (RF/anti-CCP) and aspiration if large effusion.");
      addUnique(pkg.procedures, TESTS.procedures.ASPIRATION);
    }
    
    if (bandKey === "amber" && age > 40) {
      addUnique(pkg.imaging, TESTS.imaging.XR_WB);
    }
    
    return pkg;
  }
  
  function recommendKneeWorkup(ctx) {
    const band = kneeBand(ctx.kneeScore);
    let pkg = basePackageByBand(band.key);
    pkg = applyBandSpecificExtras(pkg, ctx, band.key);
    pkg = applyModifiers(pkg, ctx);
    
    const titleByBand = {
      red: "Acute / High-Concern Knee Package",
      amber: "Structural + Inflammatory Assessment Package",
      lgreen: "Optimisation & Early Degeneration Package",
      green: "Performance & Prevention Package",
      na: "Complete the scores to see recommendations"
    };
    
    return {
      band: band.label,
      bandKey: band.key,
      title: titleByBand[band.key] || "Recommended next steps",
      imaging: pkg.imaging,
      bloods: pkg.bloods,
      procedures: pkg.procedures,
      notes: pkg.notes,
      rationale: pkg.rationale
    };
  }
  
  // ========== UI LOGIC ==========
  
  const elements = {
    kneeScore: document.getElementById('kr-knee-score'),
    sleepScore: document.getElementById('kr-sleep-score'),
    age: document.getElementById('kr-age'),
    sex: document.getElementById('kr-sex'),
    menopauseWrapper: document.getElementById('kr-menopause-wrapper'),
    menopause: document.getElementById('kr-menopause'),
    cardiac: document.getElementById('kr-cardiac'),
    thyroid: document.getElementById('kr-thyroid'),
    diabetes: document.getElementById('kr-diabetes'),
    generateBtn: document.getElementById('kr-generate-btn'),
    resultsSection: document.getElementById('kr-results-section'),
    scoreDisplay: document.getElementById('kr-score-display'),
    resultsCard: document.getElementById('kr-results-card')
  };
  
  // Show/hide menopause checkbox based on sex
  elements.sex.addEventListener('change', function() {
    if (this.value === 'female') {
      elements.menopauseWrapper.classList.remove('hidden');
    } else {
      elements.menopauseWrapper.classList.add('hidden');
      elements.menopause.checked = false;
    }
    validateForm();
  });
  
  // Form validation
  function validateForm() {
    const kneeScore = elements.kneeScore.value;
    const age = elements.age.value;
    const sex = elements.sex.value;
    
    const isValid = kneeScore !== '' && age !== '' && sex !== '';
    elements.generateBtn.disabled = !isValid;
  }
  
  // Add validation listeners
  [elements.kneeScore, elements.sleepScore, elements.age, elements.sex].forEach(el => {
    el.addEventListener('input', validateForm);
    el.addEventListener('change', validateForm);
  });
  
  // Generate recommendations
  elements.generateBtn.addEventListener('click', function() {
    const kneeScore = parseInt(elements.kneeScore.value) || 0;
    const sleepScore = parseInt(elements.sleepScore.value) || null;
    const age = parseInt(elements.age.value);
    const sex = elements.sex.value;
    
    // Calculate the score to use based on config
    let primaryScore;
    if (CONFIG.scoreSource === 'index' && sleepScore !== null) {
      primaryScore = Math.round((kneeScore + sleepScore) / 2);
    } else {
      primaryScore = kneeScore;
    }
    
    const ctx = {
      kneeScore: primaryScore,
      age: age,
      sex: sex,
      hasCardiac: elements.cardiac.checked,
      hasThyroid: elements.thyroid.checked,
      hasDiabetes: elements.diabetes.checked,
      isPeriOrPostMenopausal: elements.menopause.checked
    };
    
    const result = recommendKneeWorkup(ctx);
    renderResults(result, kneeScore, sleepScore, primaryScore);
  });
  
  function renderResults(result, kneeScore, sleepScore, indexScore) {
    // Render score display
    let scoreHTML = `
      <div class="kr-score-item">
        <div class="kr-score-value" style="color: var(--kr-${result.bandKey === 'lgreen' ? 'lgreen' : result.bandKey})">${kneeScore}</div>
        <div class="kr-score-label">Pro Knee</div>
      </div>
    `;
    
    if (sleepScore !== null) {
      const sleepBand = kneeBand(sleepScore);
      scoreHTML += `
        <div class="kr-score-item">
          <div class="kr-score-value" style="color: var(--kr-${sleepBand.key === 'lgreen' ? 'lgreen' : sleepBand.key})">${sleepScore}</div>
          <div class="kr-score-label">Sleep</div>
        </div>
        <div class="kr-score-item">
          <div class="kr-score-value" style="color: var(--kr-${result.bandKey === 'lgreen' ? 'lgreen' : result.bandKey})">${indexScore}</div>
          <div class="kr-score-label">Index</div>
        </div>
      `;
    }
    
    elements.scoreDisplay.innerHTML = scoreHTML;
    
    // Render results card
    let cardHTML = `
      <div class="kr-results-header">
        <h3>${result.title}</h3>
        <div class="kr-results-meta">
          <span class="kr-band-badge ${result.bandKey}">
            Band: ${result.band}
          </span>
          <span style="color: var(--kr-text-muted); font-size: 0.875rem;">
            Recommended tests below
          </span>
        </div>
      </div>
    `;
    
    // Imaging section
    if (result.imaging.length > 0) {
      cardHTML += renderCollapsible('Imaging', result.imaging, 'open');
    }
    
    // Bloods section
    if (result.bloods.length > 0) {
      cardHTML += renderCollapsible('Blood Tests', result.bloods, 'open');
    }
    
    // Procedures section
    if (result.procedures.length > 0) {
      cardHTML += renderCollapsible('Optional Procedures', result.procedures, '');
    }
    
    // Notes
    if (result.notes.length > 0) {
      cardHTML += `
        <div class="kr-notes">
          <h4>Clinical Notes</h4>
          <ul>
            ${result.notes.map(n => `<li>${n}</li>`).join('')}
          </ul>
        </div>
      `;
    }
    
    // Rationale
    if (CONFIG.showRationale && result.rationale.length > 0) {
      cardHTML += `
        <div class="kr-rationale">
          <h4>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/>
              <line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            Why these tests?
          </h4>
          ${result.rationale.map(r => `<p>${r}</p>`).join('')}
        </div>
      `;
    }
    
    elements.resultsCard.innerHTML = cardHTML;
    
    // Show results section
    elements.resultsSection.style.display = 'block';
    
    // Scroll to results
    elements.resultsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    
    // Add collapsible listeners
    document.querySelectorAll('.kr-collapsible-header').forEach(header => {
      header.addEventListener('click', function() {
        this.parentElement.classList.toggle('open');
      });
    });
  }
  
  function renderCollapsible(title, items, openClass) {
    return `
      <div class="kr-collapsible ${openClass}">
        <button class="kr-collapsible-header" type="button">
          <span>${title}<span class="count">${items.length}</span></span>
          <svg class="kr-collapsible-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </button>
        <div class="kr-collapsible-content">
          <ul class="kr-test-list">
            ${items.map(item => `<li>${item}</li>`).join('')}
          </ul>
        </div>
      </div>
    `;
  }
  
})();
</script>
