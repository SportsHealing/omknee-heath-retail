{% comment %}
  Knee Assessment Form Section
  ============================
  A premium, medical-grade knee assessment page with Jotform embed.
  
  Usage:
  1. Add this section to your Shopify theme's sections/ folder
  2. Create a page template that includes this section
  3. Replace the Jotform Form ID in Theme Settings or via schema
  
  Page Template Setup:
  Create templates/page.knee-assessment.json with:
  {
    "sections": {
      "main": {
        "type": "knee-assessment-form",
        "settings": {
          "jotform_id": "YOUR_JOTFORM_ID_HERE"
        }
      }
    },
    "order": ["main"]
  }
{% endcomment %}

{%- liquid
  assign form_id = section.settings.jotform_id | default: 'PLACEHOLDER_FORM_ID'
  assign section_id = section.id | default: 'knee-assessment'
-%}

{%- capture seo_title -%}Knee Assessment Questionnaire | {{ shop.name }}{%- endcapture -%}
{%- capture seo_description -%}Complete our clinician-designed knee assessment in 4–6 minutes. UK GDPR-aligned, secure, and personalised recommendations for your joint health journey.{%- endcapture -%}

{% comment %} SEO Meta Tags {% endcomment %}
{% if template.name == 'page' %}
  {% capture og_image %}{{ section.settings.og_image | image_url: width: 1200 }}{% endcapture %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "MedicalWebPage",
    "name": {{ seo_title | json }},
    "description": {{ seo_description | json }},
    "publisher": {
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ canonical_url | json }}
    }
  }
  </script>
{% endif %}

<style>
  /* Scoped styles for knee assessment section */
  #ka-{{ section_id }} {
    --ka-primary: {{ section.settings.primary_color }};
    --ka-primary-light: {{ section.settings.primary_light }};
    --ka-text: #1a1a1a;
    --ka-text-muted: #4a5568;
    --ka-bg: #ffffff;
    --ka-bg-alt: #f7f9fc;
    --ka-border: #e2e8f0;
    --ka-success: #10b981;
    --ka-radius: 12px;
    --ka-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    line-height: 1.6;
    color: var(--ka-text);
    background: var(--ka-bg);
  }

  #ka-{{ section_id }} * {
    box-sizing: border-box;
  }

  .ka-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 20px 60px;
  }

  @media (min-width: 768px) {
    .ka-container {
      padding: 60px 40px 80px;
    }
  }

  /* Hero Section */
  .ka-hero {
    text-align: center;
    margin-bottom: 40px;
  }

  .ka-hero__title {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    color: var(--ka-text);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .ka-hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    color: var(--ka-text-muted);
    margin: 0 0 24px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Trust Bar */
  .ka-trust-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 16px;
    padding: 12px 16px;
    background: var(--ka-bg-alt);
    border-radius: var(--ka-radius);
    margin-bottom: 32px;
  }

  .ka-trust-item {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ka-text-muted);
  }

  .ka-trust-item svg {
    width: 16px;
    height: 16px;
    color: var(--ka-success);
    flex-shrink: 0;
  }

  /* What Happens Section */
  .ka-info-card {
    background: var(--ka-bg-alt);
    border: 1px solid var(--ka-border);
    border-radius: var(--ka-radius);
    padding: 24px;
    margin-bottom: 32px;
  }

  .ka-info-card__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ka-text);
    margin: 0 0 16px;
  }

  .ka-info-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ka-info-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 8px 0;
    font-size: 0.9375rem;
    color: var(--ka-text-muted);
  }

  .ka-info-list li:not(:last-child) {
    border-bottom: 1px solid var(--ka-border);
  }

  .ka-info-list__icon {
    width: 20px;
    height: 20px;
    color: var(--ka-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Consent Notice */
  .ka-consent-notice {
    background: linear-gradient(135deg, var(--ka-primary-light), #f0fdf4);
    border: 1px solid var(--ka-primary);
    border-radius: var(--ka-radius);
    padding: 20px;
    margin-bottom: 24px;
  }

  .ka-consent-notice__title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ka-text);
    margin: 0 0 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ka-consent-notice__title svg {
    width: 18px;
    height: 18px;
    color: var(--ka-primary);
  }

  .ka-consent-notice__text {
    font-size: 0.8125rem;
    color: var(--ka-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .ka-consent-notice__text strong {
    color: var(--ka-text);
  }

  /* Jotform Embed */
  .ka-form-wrapper {
    background: var(--ka-bg);
    border: 1px solid var(--ka-border);
    border-radius: var(--ka-radius);
    overflow: hidden;
    box-shadow: var(--ka-shadow);
    margin-bottom: 40px;
    min-height: 500px;
  }

  .ka-form-wrapper iframe {
    width: 100%;
    min-height: 500px;
    border: none;
    display: block;
  }

  /* FAQ Section */
  .ka-faq {
    margin-bottom: 40px;
  }

  .ka-faq__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ka-text);
    margin: 0 0 20px;
  }

  .ka-faq-item {
    border: 1px solid var(--ka-border);
    border-radius: var(--ka-radius);
    margin-bottom: 12px;
    overflow: hidden;
    background: var(--ka-bg);
  }

  .ka-faq-item__trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: none;
    border: none;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ka-text);
    cursor: pointer;
    text-align: left;
    transition: background 0.2s;
  }

  .ka-faq-item__trigger:hover {
    background: var(--ka-bg-alt);
  }

  .ka-faq-item__trigger svg {
    width: 20px;
    height: 20px;
    color: var(--ka-text-muted);
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  .ka-faq-item[open] .ka-faq-item__trigger svg {
    transform: rotate(180deg);
  }

  .ka-faq-item__content {
    padding: 0 20px 16px;
    font-size: 0.875rem;
    color: var(--ka-text-muted);
    line-height: 1.6;
  }

  .ka-faq-item__content p {
    margin: 0;
  }

  /* Back Button */
  .ka-back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: var(--ka-bg-alt);
    border: 1px solid var(--ka-border);
    border-radius: var(--ka-radius);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ka-text);
    text-decoration: none;
    transition: all 0.2s;
  }

  .ka-back-link:hover {
    background: var(--ka-primary-light);
    border-color: var(--ka-primary);
    color: var(--ka-primary);
  }

  .ka-back-link svg {
    width: 18px;
    height: 18px;
  }

  /* Footer Note */
  .ka-footer-note {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--ka-border);
    text-align: center;
    font-size: 0.75rem;
    color: var(--ka-text-muted);
  }
</style>

<section id="ka-{{ section_id }}" class="ka-section" aria-labelledby="ka-title-{{ section_id }}">
  <div class="ka-container">
    
    <!-- Hero -->
    <header class="ka-hero">
      <h1 id="ka-title-{{ section_id }}" class="ka-hero__title">{{ section.settings.heading }}</h1>
      <p class="ka-hero__subtitle">{{ section.settings.subheading }}</p>
    </header>

    <!-- Trust Bar -->
    <div class="ka-trust-bar" role="list" aria-label="Trust indicators">
      <span class="ka-trust-item" role="listitem">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        UK GDPR-aligned
      </span>
      <span class="ka-trust-item" role="listitem">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        Secure
      </span>
      <span class="ka-trust-item" role="listitem">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
        </svg>
        Clinician-designed
      </span>
    </div>

    <!-- What Happens After Submission -->
    <div class="ka-info-card">
      <h2 class="ka-info-card__title">What happens after you submit?</h2>
      <ul class="ka-info-list">
        <li>
          <svg class="ka-info-list__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          <span><strong>Score banding:</strong> Your responses are scored and grouped into bands (Excellent, Good, Fair, or Pay Attention) to give you a clear picture.</span>
        </li>
        <li>
          <svg class="ka-info-list__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
          </svg>
          <span><strong>Recommended next steps:</strong> Personalised guidance based on your score, including lifestyle tips and product suggestions.</span>
        </li>
        <li>
          <svg class="ka-info-list__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span><strong>Optional booking:</strong> If you'd like expert guidance, you can book a consultation with our clinical team.</span>
        </li>
      </ul>
    </div>

    <!-- Consent Notice -->
    <div class="ka-consent-notice">
      <h3 class="ka-consent-notice__title">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Before you begin
      </h3>
      <p class="ka-consent-notice__text">
        <strong>Clinical processing consent</strong> is required to complete this assessment and is collected within the form. 
        <strong>Marketing consent</strong> is optional — you can choose whether to receive updates about joint health tips and offers.
      </p>
    </div>

    <!-- Jotform Embed -->
    <div class="ka-form-wrapper" aria-label="Knee assessment form">
      <script type="text/javascript" src="https://form.jotform.com/jsform/{{ form_id }}"></script>
      <noscript>
        <p style="padding: 20px; text-align: center;">
          Please enable JavaScript to view this form, or 
          <a href="https://form.jotform.com/{{ form_id }}" target="_blank" rel="noopener">open the form directly</a>.
        </p>
      </noscript>
    </div>

    <!-- FAQ Section -->
    <div class="ka-faq">
      <h2 class="ka-faq__title">Frequently Asked Questions</h2>

      <details class="ka-faq-item">
        <summary class="ka-faq-item__trigger">
          Is this medical advice?
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="ka-faq-item__content">
          <p>No. This assessment is designed to help you understand your knee health and identify areas for improvement. It is not a medical diagnosis. If you have concerns about your knee health, please consult a qualified healthcare professional. Our recommendations are educational and based on general wellness principles.</p>
        </div>
      </details>

      <details class="ka-faq-item">
        <summary class="ka-faq-item__trigger">
          How is my data used?
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="ka-faq-item__content">
          <p>Your data is processed by Jotform on UK/EU-based servers (Enterprise data residency). We use your responses solely to generate your personalised score and recommendations. If you consent to marketing, we may send occasional emails about joint health. Your data is never sold to third parties.</p>
        </div>
      </details>

      <details class="ka-faq-item">
        <summary class="ka-faq-item__trigger">
          How long do you keep my data?
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="ka-faq-item__content">
          <p>Assessment data is retained for up to 24 months to allow us to track your progress if you retake the assessment. Marketing preferences are retained until you unsubscribe. You can request earlier deletion at any time.</p>
        </div>
      </details>

      <details class="ka-faq-item">
        <summary class="ka-faq-item__trigger">
          Can I request deletion?
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
          </svg>
        </summary>
        <div class="ka-faq-item__content">
          <p>Yes. Under UK GDPR, you have the right to request deletion of your personal data. Contact us at privacy@omkneehealth.com with your request, and we will process it within 30 days. Please note that deletion is permanent and cannot be undone.</p>
        </div>
      </details>
    </div>

    <!-- Back Button -->
    <a href="/collections/joint-health" class="ka-back-link">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
      </svg>
      Back to Joint Health
    </a>

    <!-- Footer Note -->
    <p class="ka-footer-note">
      This assessment is provided for educational purposes only. OmKneeHealth Ltd is registered in England & Wales. 
      For medical concerns, please consult a qualified healthcare professional.
    </p>

  </div>
</section>

{% schema %}
{
  "name": "Knee Assessment Form",
  "tag": "section",
  "class": "knee-assessment-section",
  "settings": [
    {
      "type": "header",
      "content": "Jotform Settings"
    },
    {
      "type": "text",
      "id": "jotform_id",
      "label": "Jotform Form ID",
      "info": "Enter your Jotform form ID (e.g., 241234567890123). Find this in your Jotform URL.",
      "default": "PLACEHOLDER_FORM_ID"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Knee Assessment Questionnaire"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Complete this in 4–6 minutes to help us recommend the right next steps."
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#166534"
    },
    {
      "type": "color",
      "id": "primary_light",
      "label": "Primary Light",
      "default": "#dcfce7"
    },
    {
      "type": "header",
      "content": "SEO & Open Graph"
    },
    {
      "type": "image_picker",
      "id": "og_image",
      "label": "Open Graph Image",
      "info": "Recommended: 1200x630px"
    }
  ],
  "presets": [
    {
      "name": "Knee Assessment Form",
      "category": "Custom"
    }
  ]
}
{% endschema %}
