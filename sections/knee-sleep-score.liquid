{% comment %}
  OmKneeHealth Knee + Sleep Score Calculator
  Shopify Online Store 2.0 Section
  
  A patient-reported knee and sleep health score with transparent domain 
  contributors and a combined index (0–100).
  
  Features:
  - 7 knee domains with mixed native scales, normalized to 0-100
  - 7 sleep contributors (0-100 scale)
  - Partial completion support with normalized weights
  - Copy results functionality
  - Optional Shopify/Klaviyo event hooks (commented)
{% endcomment %}

<section 
  id="omk-score-section-{{ section.id }}" 
  class="omk-score-section"
  data-section-id="{{ section.id }}"
  data-min-knee-domains="{{ section.settings.min_knee_domains }}"
  data-show-weights="{{ section.settings.show_weights }}"
>
  <div class="omk-score-container">
    {%- comment -%} Header {%- endcomment -%}
    <header class="omk-score-header">
      <div class="omk-score-logo">
        <span class="omk-logo-text">OmKneeHealth</span>
      </div>
      <h2 class="omk-score-title">{{ section.settings.heading }}</h2>
      <p class="omk-score-subtitle">
        A patient-reported knee and sleep health score with transparent domain contributors and a combined index (0–100).
      </p>
      <p class="omk-score-note">
        Knee domains use native scales (0–10 or 0–5) and are normalised to 0–100 before weighting.
      </p>
    </header>

    {%- comment -%} Start/Reset Buttons {%- endcomment -%}
    <div class="omk-score-actions-top">
      <button type="button" class="omk-btn omk-btn-primary" id="omk-start-btn-{{ section.id }}">
        Start Assessment
      </button>
      <button type="button" class="omk-btn omk-btn-secondary" id="omk-reset-btn-{{ section.id }}">
        Reset
      </button>
    </div>

    {%- comment -%} Main Grid {%- endcomment -%}
    <div class="omk-score-grid">
      
      {%- comment -%} Knee Score Panel {%- endcomment -%}
      <div class="omk-score-panel" id="omk-knee-panel-{{ section.id }}">
        <div class="omk-panel-header">
          <h3 class="omk-panel-title">Proprietary Knee Score</h3>
          <span class="omk-panel-meta">7 domains • weighted • 0–100</span>
        </div>
        <p class="omk-panel-desc">
          Enter each knee domain on its native scale. The tool normalises each to 0–100 and applies normalised weighting.
        </p>
        
        <div class="omk-table-wrapper">
          <table class="omk-table">
            <thead>
              <tr>
                <th>Domain</th>
                <th class="omk-col-right">Raw</th>
                <th class="omk-col-right omk-weight-col">Weight</th>
                <th class="omk-col-right">Weighted (0–100)</th>
              </tr>
            </thead>
            <tbody id="omk-knee-rows-{{ section.id }}">
              {%- comment -%} Rows populated by JS {%- endcomment -%}
            </tbody>
          </table>
        </div>

        <div class="omk-result-box">
          <div class="omk-result-scores">
            <span class="omk-result-label">Pro Knee</span>
            <span class="omk-result-value" id="omk-knee-total-{{ section.id }}">—</span>
            <span class="omk-result-band" id="omk-knee-band-{{ section.id }}">—</span>
          </div>
          <div class="omk-result-meaning">
            <span class="omk-meaning-label">What it means</span>
            <p class="omk-meaning-text" id="omk-knee-meaning-{{ section.id }}">
              Fill in the domains to see your score band and next steps.
            </p>
          </div>
        </div>
      </div>

      {%- comment -%} Sleep Score Panel {%- endcomment -%}
      <div class="omk-score-panel" id="omk-sleep-panel-{{ section.id }}">
        <div class="omk-panel-header">
          <h3 class="omk-panel-title">Sleep Score</h3>
          <span class="omk-panel-meta">7 contributors • weighted • 0–100</span>
        </div>
        <p class="omk-panel-desc">
          Enter each sleep contributor from 0 to 100 (100 = best). Weights are normalised across answered contributors.
        </p>
        
        <div class="omk-table-wrapper">
          <table class="omk-table">
            <thead>
              <tr>
                <th>Contributor</th>
                <th class="omk-col-right">Value</th>
                <th class="omk-col-right omk-weight-col">Weight</th>
                <th class="omk-col-right">Weighted</th>
              </tr>
            </thead>
            <tbody id="omk-sleep-rows-{{ section.id }}">
              {%- comment -%} Rows populated by JS {%- endcomment -%}
            </tbody>
          </table>
        </div>

        <div class="omk-result-box">
          <div class="omk-result-scores">
            <span class="omk-result-label">Sleep</span>
            <span class="omk-result-value" id="omk-sleep-total-{{ section.id }}">—</span>
            <span class="omk-result-band" id="omk-sleep-band-{{ section.id }}">—</span>
          </div>
          <div class="omk-result-meaning">
            <span class="omk-meaning-label">What it means</span>
            <p class="omk-meaning-text" id="omk-sleep-meaning-{{ section.id }}">
              Fill in the contributors to see your band and next steps.
            </p>
          </div>
        </div>
      </div>

      {%- comment -%} Combined Index Panel {%- endcomment -%}
      <div class="omk-score-panel omk-index-panel" id="omk-index-panel-{{ section.id }}">
        <div class="omk-panel-header">
          <h3 class="omk-panel-title">Knee + Sleep Health Index</h3>
          <span class="omk-panel-meta">0–100 • combined index</span>
        </div>

        <div class="omk-result-box omk-result-box-index">
          <div class="omk-result-scores omk-result-scores-large">
            <span class="omk-result-label">Index</span>
            <span class="omk-result-value omk-result-value-large" id="omk-index-total-{{ section.id }}">—</span>
            <span class="omk-result-band" id="omk-index-band-{{ section.id }}">—</span>
          </div>
          <div class="omk-result-meaning">
            <span class="omk-meaning-label">Next steps</span>
            <p class="omk-meaning-text" id="omk-index-meaning-{{ section.id }}">
              Your Index is the average of Pro Knee and Sleep. It's a decision-support snapshot, not a diagnosis.
            </p>
          </div>

          <div class="omk-cta-actions">
            {%- if section.settings.cta_url != blank -%}
              <a href="{{ section.settings.cta_url }}" class="omk-btn omk-btn-primary omk-btn-cta" id="omk-cta-btn-{{ section.id }}">
                {{ section.settings.cta_text }}
              </a>
            {%- endif -%}
            <button type="button" class="omk-btn omk-btn-secondary" id="omk-copy-btn-{{ section.id }}">
              Copy results
            </button>
            <button type="button" class="omk-btn omk-btn-tertiary" id="omk-print-btn-{{ section.id }}">
              Print
            </button>
          </div>

          <details class="omk-disclaimer">
            <summary>Clinical disclaimer</summary>
            <p>
              This tool is for education and decision-support only. It does not provide a diagnosis.
              If you have severe pain, swelling, locking, fevers, calf swelling, numbness, or significant injury,
              seek urgent medical assessment.
            </p>
          </details>

          <details class="omk-disclaimer">
            <summary>Data & privacy</summary>
            <p>
              Scores are calculated in your browser. No results are transmitted unless you connect it to a form/CRM.
            </p>
          </details>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ========================================
     OmKneeHealth Knee + Sleep Score Styles
     Premium wellness aesthetic: clean, calming
     ======================================== */
  
  .omk-score-section {
    --omk-primary: #1a3c34;
    --omk-primary-light: #2d5a4e;
    --omk-secondary: #f8f6f3;
    --omk-accent: #8ba89a;
    --omk-text: #1a1a1a;
    --omk-text-muted: #6b7280;
    --omk-border: rgba(139, 168, 154, 0.25);
    --omk-bg: #ffffff;
    --omk-bg-soft: #fafaf8;
    --omk-shadow: 0 4px 20px rgba(26, 60, 52, 0.08);
    --omk-shadow-sm: 0 2px 8px rgba(26, 60, 52, 0.06);
    
    /* Score bands */
    --omk-excellent: #1a3c34;
    --omk-good: #2d5a4e;
    --omk-fair: #d97706;
    --omk-attention: #dc2626;
    
    /* Typography */
    --omk-font-serif: 'EB Garamond', 'Georgia', serif;
    --omk-font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    
    font-family: var(--omk-font-sans);
    color: var(--omk-text);
    background: var(--omk-bg);
    padding: 4rem 1.5rem;
    line-height: 1.6;
  }

  .omk-score-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header */
  .omk-score-header {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .omk-score-logo {
    margin-bottom: 1.5rem;
  }

  .omk-logo-text {
    font-family: var(--omk-font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--omk-primary);
    letter-spacing: 0.02em;
  }

  .omk-score-title {
    font-family: var(--omk-font-serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    color: var(--omk-primary);
    margin: 0 0 1rem 0;
    letter-spacing: -0.01em;
  }

  .omk-score-subtitle {
    font-size: 1.0625rem;
    color: var(--omk-text-muted);
    margin: 0 0 0.75rem 0;
    line-height: 1.7;
  }

  .omk-score-note {
    font-size: 0.875rem;
    color: var(--omk-text-muted);
    margin: 0;
    font-style: italic;
  }

  /* Top Actions */
  .omk-score-actions-top {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  /* Buttons */
  .omk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    font-family: var(--omk-font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    white-space: nowrap;
  }

  .omk-btn-primary {
    background: var(--omk-primary);
    color: #ffffff;
    border-color: var(--omk-primary);
  }

  .omk-btn-primary:hover {
    background: var(--omk-primary-light);
    border-color: var(--omk-primary-light);
  }

  .omk-btn-secondary {
    background: transparent;
    color: var(--omk-primary);
    border-color: var(--omk-border);
  }

  .omk-btn-secondary:hover {
    background: var(--omk-secondary);
    border-color: var(--omk-primary);
  }

  .omk-btn-tertiary {
    background: transparent;
    color: var(--omk-text-muted);
    border-color: transparent;
    padding: 0.5rem 1rem;
  }

  .omk-btn-tertiary:hover {
    color: var(--omk-primary);
    background: var(--omk-bg-soft);
  }

  .omk-btn-cta {
    padding: 0.875rem 2rem;
  }

  /* Grid */
  .omk-score-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  /* Panels */
  .omk-score-panel {
    background: var(--omk-bg);
    border: 1px solid var(--omk-border);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: var(--omk-shadow-sm);
  }

  .omk-index-panel {
    grid-column: 1 / -1;
  }

  .omk-panel-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    margin-bottom: 0.75rem;
  }

  .omk-panel-title {
    font-family: var(--omk-font-serif);
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--omk-primary);
    margin: 0;
  }

  .omk-panel-meta {
    font-size: 0.8125rem;
    color: var(--omk-text-muted);
  }

  .omk-panel-desc {
    font-size: 0.9375rem;
    color: var(--omk-text-muted);
    margin: 0 0 1.5rem 0;
    line-height: 1.6;
  }

  /* Tables */
  .omk-table-wrapper {
    overflow-x: auto;
    margin-bottom: 1.5rem;
    border: 1px solid var(--omk-border);
    border-radius: 8px;
  }

  .omk-table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  .omk-table th,
  .omk-table td {
    padding: 0.875rem 1rem;
    text-align: left;
    border-bottom: 1px solid var(--omk-border);
  }

  .omk-table thead th {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--omk-text-muted);
    background: var(--omk-bg-soft);
  }

  .omk-table tbody tr:last-child td {
    border-bottom: none;
  }

  .omk-table tbody tr:hover {
    background: var(--omk-bg-soft);
  }

  .omk-col-right {
    text-align: right;
  }

  .omk-weight-col {
    display: none;
  }

  .omk-score-section[data-show-weights="true"] .omk-weight-col {
    display: table-cell;
  }

  /* Inputs */
  .omk-input {
    width: 5rem;
    padding: 0.5rem 0.625rem;
    font-family: var(--omk-font-sans);
    font-size: 0.9375rem;
    border: 1px solid var(--omk-border);
    border-radius: 6px;
    background: var(--omk-bg);
    color: var(--omk-text);
    text-align: right;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .omk-input:focus {
    outline: none;
    border-color: var(--omk-primary);
    box-shadow: 0 0 0 3px rgba(26, 60, 52, 0.1);
  }

  .omk-input::placeholder {
    color: var(--omk-text-muted);
    opacity: 0.6;
  }

  /* Remove number input spinners */
  .omk-input::-webkit-outer-spin-button,
  .omk-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .omk-input[type=number] {
    -moz-appearance: textfield;
  }

  /* Result Box */
  .omk-result-box {
    background: var(--omk-bg-soft);
    border: 1px solid var(--omk-border);
    border-radius: 8px;
    padding: 1.5rem;
  }

  .omk-result-box-index {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .omk-result-scores {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .omk-result-scores-large {
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .omk-result-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--omk-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .omk-result-value {
    font-family: var(--omk-font-serif);
    font-size: 2rem;
    font-weight: 400;
    color: var(--omk-primary);
  }

  .omk-result-value-large {
    font-size: 3rem;
  }

  .omk-result-band {
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    background: var(--omk-secondary);
    border: 1px solid var(--omk-border);
    color: var(--omk-text-muted);
  }

  .omk-result-meaning {
    border-top: 1px solid var(--omk-border);
    padding-top: 1rem;
  }

  .omk-meaning-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--omk-text-muted);
    margin-bottom: 0.5rem;
  }

  .omk-meaning-text {
    font-size: 0.9375rem;
    color: var(--omk-text);
    margin: 0;
    line-height: 1.6;
  }

  /* CTA Actions */
  .omk-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--omk-border);
  }

  /* Disclaimers */
  .omk-disclaimer {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--omk-text-muted);
    text-align: left;
  }

  .omk-disclaimer summary {
    cursor: pointer;
    font-weight: 500;
    padding: 0.5rem 0;
  }

  .omk-disclaimer summary:hover {
    color: var(--omk-primary);
  }

  .omk-disclaimer p {
    margin: 0.5rem 0 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--omk-border);
    line-height: 1.6;
  }

  /* Band Colors */
  .omk-band-excellent { color: var(--omk-excellent) !important; }
  .omk-band-good { color: var(--omk-good) !important; }
  .omk-band-fair { color: var(--omk-fair) !important; }
  .omk-band-attention { color: var(--omk-attention) !important; }

  /* Responsive */
  @media (max-width: 900px) {
    .omk-score-grid {
      grid-template-columns: 1fr;
    }
    
    .omk-index-panel {
      grid-column: 1;
    }
  }

  @media (max-width: 600px) {
    .omk-score-section {
      padding: 2.5rem 1rem;
    }

    .omk-score-panel {
      padding: 1.5rem;
    }

    .omk-score-actions-top {
      flex-direction: column;
    }

    .omk-result-value-large {
      font-size: 2.5rem;
    }

    .omk-cta-actions {
      flex-direction: column;
    }

    .omk-cta-actions .omk-btn {
      width: 100%;
    }
  }

  /* Print styles */
  @media print {
    .omk-score-section {
      padding: 1rem;
    }

    .omk-btn,
    .omk-score-actions-top {
      display: none !important;
    }

    .omk-score-panel {
      break-inside: avoid;
      box-shadow: none;
      border: 1px solid #ccc;
    }
  }
</style>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const section = document.getElementById('omk-score-section-' + sectionId);
  if (!section) return;

  const minKneeDomains = parseInt(section.dataset.minKneeDomains, 10) || 5;
  const showWeights = section.dataset.showWeights === 'true';

  // ========= DOMAINS =========
  // Knee: RAW inputs are mixed-scale; each is normalised to 0–100 using (raw/max)*100.
  const kneeDomains = [
    { key: 'pain',     label: 'Pain',                        max: 10 },
    { key: 'sleep',    label: 'Disturbed sleep',             max: 10 },
    { key: 'swell',    label: 'Swelling',                    max: 5  },
    { key: 'instab',   label: 'Instability / giving way',    max: 5  },
    { key: 'stiff',    label: 'Stiffness / ROM restriction', max: 5  },
    { key: 'stairs',   label: 'Stairs (climb & descend)',    max: 5  },
    { key: 'function', label: 'Function & mobility',         max: 10 }
  ];

  // Sleep: values are already 0–100.
  const sleepDomains = [
    { key: 'total',   label: 'Total sleep',      max: 100 },
    { key: 'eff',     label: 'Efficiency',       max: 100 },
    { key: 'rest',    label: 'Restfulness',      max: 100 },
    { key: 'rem',     label: 'REM sleep',        max: 100 },
    { key: 'deep',    label: 'Deep sleep',       max: 100 },
    { key: 'latency', label: 'Latency',          max: 100 },
    { key: 'timing',  label: 'Timing',           max: 100 }
  ];

  const defaultWeight = 1;

  // Element references
  const kneeTbody = document.getElementById('omk-knee-rows-' + sectionId);
  const sleepTbody = document.getElementById('omk-sleep-rows-' + sectionId);

  // Utilities
  function clamp(n, min, max) {
    if (Number.isNaN(n)) return null;
    return Math.min(max, Math.max(min, n));
  }

  function bandFor(score) {
    if (score === null) return { name: '—', className: '', color: 'var(--omk-text-muted)' };
    if (score >= 85) return { name: 'Excellent/Optimal', className: 'omk-band-excellent', color: 'var(--omk-excellent)' };
    if (score >= 70) return { name: 'Good', className: 'omk-band-good', color: 'var(--omk-good)' };
    if (score >= 60) return { name: 'Fair', className: 'omk-band-fair', color: 'var(--omk-fair)' };
    return { name: 'Pay attention', className: 'omk-band-attention', color: 'var(--omk-attention)' };
  }

  function meaningFor(type, score) {
    const b = bandFor(score).name;
    if (score === null) return 'Enter values to see guidance.';

    if (type === 'knee') {
      if (b === 'Excellent/Optimal') return 'Your knee profile looks strong. Maintain consistency and avoid load spikes. Address any lowest domain early.';
      if (b === 'Good') return 'Generally doing well. Improve the lowest domain (often pain, stiffness or stairs) with targeted strengthening and load management.';
      if (b === 'Fair') return 'Some domains may be limiting. Consider a structured rehab plan and, if swelling/instability persists, clinical assessment.';
      return 'Several domains are limiting. If persistent, consider clinical review and an appropriate imaging/rehab pathway.';
    }

    if (type === 'sleep') {
      if (b === 'Excellent/Optimal') return 'Sleep looks supportive of recovery. Maintain timing and wind-down habits.';
      if (b === 'Good') return 'Sleep is reasonable. Improve the lowest contributor (often latency, restfulness or timing).';
      if (b === 'Fair') return 'Sleep may be impacting pain and recovery. Consider routine changes and targeted interventions.';
      return 'Sleep is likely limiting recovery. Consider structured sleep support and review contributors driving the low score.';
    }

    // index
    if (b === 'Excellent/Optimal') return 'Overall recovery inputs look strong. Keep consistent habits and focus on prevention.';
    if (b === 'Good') return 'Good profile. Improve the lowest knee domain and weakest sleep contributor to move into optimal range.';
    if (b === 'Fair') return 'Mixed profile. Prioritise the lowest knee domain and lowest sleep contributor with a structured plan.';
    return 'Higher risk profile. Consider a structured pathway (clinical assessment + targeted rehab ± imaging when appropriate).';
  }

  function rowTemplate(domain, group) {
    const tr = document.createElement('tr');

    const tdLabel = document.createElement('td');
    tdLabel.textContent = domain.label;

    const tdVal = document.createElement('td');
    tdVal.className = 'omk-col-right';
    const val = document.createElement('input');
    val.type = 'number';
    val.step = '1';
    val.inputMode = 'numeric';
    val.className = 'omk-input';
    val.dataset.group = group;
    val.dataset.key = domain.key;
    val.setAttribute('aria-label', domain.label + ' value');
    val.min = '0';
    val.max = String(domain.max);
    val.placeholder = '0–' + domain.max;
    tdVal.appendChild(val);

    const tdW = document.createElement('td');
    tdW.className = 'omk-col-right omk-weight-col';
    const w = document.createElement('input');
    w.type = 'number';
    w.min = '0';
    w.max = '10';
    w.step = '0.1';
    w.inputMode = 'decimal';
    w.className = 'omk-input';
    w.value = defaultWeight;
    w.dataset.group = group;
    w.dataset.key = domain.key;
    w.dataset.role = 'weight';
    w.setAttribute('aria-label', domain.label + ' weight');
    tdW.appendChild(w);

    const tdWeighted = document.createElement('td');
    tdWeighted.className = 'omk-col-right';
    tdWeighted.id = 'omk-weighted-' + sectionId + '-' + group + '-' + domain.key;
    tdWeighted.textContent = '—';

    tr.appendChild(tdLabel);
    tr.appendChild(tdVal);
    tr.appendChild(tdW);
    tr.appendChild(tdWeighted);
    return tr;
  }

  function buildTables() {
    kneeTbody.innerHTML = '';
    sleepTbody.innerHTML = '';
    kneeDomains.forEach(function(d) { kneeTbody.appendChild(rowTemplate(d, 'knee')); });
    sleepDomains.forEach(function(d) { sleepTbody.appendChild(rowTemplate(d, 'sleep')); });
  }

  function readGroup(group) {
    var inputs = section.querySelectorAll('input[data-group="' + group + '"]');
    var values = {};
    var weights = {};

    inputs.forEach(function(inp) {
      var key = inp.dataset.key;
      var isWeight = inp.dataset.role === 'weight';
      var num = Number(inp.value);

      if (isWeight) {
        weights[key] = clamp(num, 0, 10) || 0;
      } else {
        values[key] = (inp.value === '') ? null : num;
      }
    });

    return { values: values, weights: weights };
  }

  function computeWeighted(group) {
    var data = readGroup(group);
    var values = data.values;
    var weights = data.weights;
    var domains = (group === 'knee') ? kneeDomains : sleepDomains;

    var answered = domains.filter(function(d) { return values[d.key] !== null; });

    if (answered.length === 0) {
      domains.forEach(function(d) {
        var el = document.getElementById('omk-weighted-' + sectionId + '-' + group + '-' + d.key);
        if (el) el.textContent = '—';
      });
      return null;
    }

    // For knee: check minimum domains requirement
    if (group === 'knee' && answered.length < minKneeDomains) {
      domains.forEach(function(d) {
        var el = document.getElementById('omk-weighted-' + sectionId + '-' + group + '-' + d.key);
        if (el) el.textContent = (values[d.key] !== null) ? '...' : '—';
      });
      return null;
    }

    var wSum = answered.reduce(function(s, d) { return s + (Number(weights[d.key]) || 0); }, 0);
    var total = 0;

    domains.forEach(function(d) {
      var el = document.getElementById('omk-weighted-' + sectionId + '-' + group + '-' + d.key);

      if (values[d.key] === null) {
        if (el) el.textContent = '—';
        return;
      }

      var raw = clamp(Number(values[d.key]), 0, d.max);
      var normalised = (raw / d.max) * 100;
      var wNorm = (wSum > 0) ? ((Number(weights[d.key]) || 0) / wSum) : (1 / answered.length);
      var weighted = normalised * wNorm;

      if (el) el.textContent = weighted.toFixed(1);
      total += weighted;
    });

    return Math.round(total);
  }

  function setBand(el, bandObj) {
    if (!el) return;
    el.textContent = bandObj.name;
    el.className = 'omk-result-band ' + bandObj.className;
    el.style.color = bandObj.color;
  }

  function render() {
    var knee = computeWeighted('knee');
    var sleep = computeWeighted('sleep');
    var index = (knee === null || sleep === null) ? null : Math.round((knee + sleep) / 2);

    // Knee
    document.getElementById('omk-knee-total-' + sectionId).textContent = (knee === null) ? '—' : String(knee);
    setBand(document.getElementById('omk-knee-band-' + sectionId), bandFor(knee));
    document.getElementById('omk-knee-meaning-' + sectionId).textContent = meaningFor('knee', knee);

    // Sleep
    document.getElementById('omk-sleep-total-' + sectionId).textContent = (sleep === null) ? '—' : String(sleep);
    setBand(document.getElementById('omk-sleep-band-' + sectionId), bandFor(sleep));
    document.getElementById('omk-sleep-meaning-' + sectionId).textContent = meaningFor('sleep', sleep);

    // Index
    document.getElementById('omk-index-total-' + sectionId).textContent = (index === null) ? '—' : String(index);
    setBand(document.getElementById('omk-index-band-' + sectionId), bandFor(index));
    document.getElementById('omk-index-meaning-' + sectionId).textContent = meaningFor('index', index);

    // ========= OPTIONAL: Shopify/Klaviyo Event Hooks =========
    // Uncomment and customize as needed:
    
    // if (knee !== null && sleep !== null && index !== null) {
    //   // Shopify Analytics
    //   if (window.Shopify && window.Shopify.analytics) {
    //     window.Shopify.analytics.publish('omknee_score_calculated', {
    //       knee_score: knee,
    //       sleep_score: sleep,
    //       combined_index: index,
    //       knee_band: bandFor(knee).name,
    //       sleep_band: bandFor(sleep).name,
    //       index_band: bandFor(index).name
    //     });
    //   }
    //
    //   // Klaviyo Event
    //   if (window._learnq) {
    //     window._learnq.push(['track', 'Knee Sleep Score Calculated', {
    //       KneeScore: knee,
    //       SleepScore: sleep,
    //       CombinedIndex: index,
    //       KneeBand: bandFor(knee).name,
    //       SleepBand: bandFor(sleep).name,
    //       IndexBand: bandFor(index).name
    //     }]);
    //   }
    // }
  }

  function resetAll() {
    var inputs = section.querySelectorAll('input.omk-input');
    inputs.forEach(function(inp) {
      if (inp.dataset.role === 'weight') {
        inp.value = defaultWeight;
      } else {
        inp.value = '';
      }
    });
    render();
  }

  function copyResults() {
    var knee = computeWeighted('knee');
    var sleep = computeWeighted('sleep');
    var index = (knee === null || sleep === null) ? null : Math.round((knee + sleep) / 2);

    var kneeBand = bandFor(knee).name;
    var sleepBand = bandFor(sleep).name;
    var idxBand = bandFor(index).name;

    var kneeDetail = kneeDomains.map(function(d) {
      var v = section.querySelector('input[data-group="knee"][data-key="' + d.key + '"]:not([data-role])').value || '—';
      var w = section.querySelector('input[data-group="knee"][data-key="' + d.key + '"][data-role="weight"]').value || '—';
      return d.label + ': ' + v + '/' + d.max + ' (w ' + w + ')';
    }).join('\n');

    var sleepDetail = sleepDomains.map(function(d) {
      var v = section.querySelector('input[data-group="sleep"][data-key="' + d.key + '"]:not([data-role])').value || '—';
      var w = section.querySelector('input[data-group="sleep"][data-key="' + d.key + '"][data-role="weight"]').value || '—';
      return d.label + ': ' + v + '/100 (w ' + w + ')';
    }).join('\n');

    var txt =
'OmKneeHealth Knee + Sleep Score\n' +
'Pro Knee: ' + (knee !== null ? knee : '—') + ' (' + kneeBand + ')\n' +
'Sleep: ' + (sleep !== null ? sleep : '—') + ' (' + sleepBand + ')\n' +
'Index: ' + (index !== null ? index : '—') + ' (' + idxBand + ')\n\n' +
'Knee domains (raw):\n' + kneeDetail + '\n\n' +
'Sleep contributors:\n' + sleepDetail;

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(txt).then(function() {
        var btn = document.getElementById('omk-copy-btn-' + sectionId);
        if (btn) {
          var oldText = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(function() { btn.textContent = oldText; }, 1500);
        }
      }).catch(function() {
        alert('Copy failed — please select and copy manually.');
      });
    } else {
      // Fallback for older browsers
      var textarea = document.createElement('textarea');
      textarea.value = txt;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        var btn = document.getElementById('omk-copy-btn-' + sectionId);
        if (btn) {
          var oldText = btn.textContent;
          btn.textContent = 'Copied!';
          setTimeout(function() { btn.textContent = oldText; }, 1500);
        }
      } catch (e) {
        alert('Copy failed — please select and copy manually.');
      }
      document.body.removeChild(textarea);
    }

    // ========= OPTIONAL: Track copy event =========
    // if (window._learnq) {
    //   window._learnq.push(['track', 'Knee Sleep Score Copied', {
    //     KneeScore: knee,
    //     SleepScore: sleep,
    //     CombinedIndex: index
    //   }]);
    // }
  }

  function startScroll() {
    var firstInput = section.querySelector('input[data-group="knee"]:not([data-role])');
    if (firstInput) {
      firstInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
      setTimeout(function() { firstInput.focus(); }, 400);
    }
  }

  // Initialize
  buildTables();
  render();

  // Event listeners
  section.addEventListener('input', function(e) {
    if (e.target && e.target.classList && e.target.classList.contains('omk-input')) {
      render();
    }
  });

  var resetBtn = document.getElementById('omk-reset-btn-' + sectionId);
  if (resetBtn) resetBtn.addEventListener('click', resetAll);

  var copyBtn = document.getElementById('omk-copy-btn-' + sectionId);
  if (copyBtn) copyBtn.addEventListener('click', copyResults);

  var printBtn = document.getElementById('omk-print-btn-' + sectionId);
  if (printBtn) printBtn.addEventListener('click', function() { window.print(); });

  var startBtn = document.getElementById('omk-start-btn-' + sectionId);
  if (startBtn) startBtn.addEventListener('click', startScroll);

})();
</script>

