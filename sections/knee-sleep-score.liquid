  "limit": 1,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Knee + Sleep Score"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Book your consultation"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Button URL"
    },
    {
      "type": "checkbox",
      "id": "show_weights",
      "label": "Show weight inputs",
      "default": false,
      "info": "Allow users to adjust domain weights"
    },
    {
      "type": "range",
      "id": "min_knee_domains",
      "label": "Minimum knee domains required",
      "min": 1,
      "max": 7,
      "step": 1,
      "default": 5,
      "info": "Minimum answered knee domains before showing total score"
    }
  ],
  "presets": [
    {
      "name": "Knee + Sleep Score",
      "category": "Health Assessment"
    }
  ]
}
{% endschema %}
