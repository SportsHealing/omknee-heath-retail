<script>
(function() {
  const sectionId = '{{ section_id }}';
  const formId = '{{ form_id }}';
  const jotformBaseUrl = '{{ section.settings.jotform_base_url | default: "https://submit.jotform.com/submit" }}';
  
  // Field mapping: local name -> Jotform field ID (configure in theme settings)
  const fieldMap = {
    first_name: '{{ section.settings.field_first_name | default: "3" }}',
    last_name: '{{ section.settings.field_last_name | default: "4" }}',
    dob: '{{ section.settings.field_dob | default: "5" }}',
    email: '{{ section.settings.field_email | default: "6" }}',
    mobile: '{{ section.settings.field_mobile | default: "7" }}',
    postcode: '{{ section.settings.field_postcode | default: "8" }}',
    consent_clinical: '{{ section.settings.field_consent_clinical | default: "9" }}',
    consent_marketing: '{{ section.settings.field_consent_marketing | default: "10" }}',
    pain: '{{ section.settings.field_pain | default: "11" }}',
    sleep: '{{ section.settings.field_sleep | default: "12" }}',
    swelling: '{{ section.settings.field_swelling | default: "13" }}',
    instability: '{{ section.settings.field_instability | default: "14" }}',
    stiffness: '{{ section.settings.field_stiffness | default: "15" }}',
    stairs: '{{ section.settings.field_stairs | default: "16" }}',
    function: '{{ section.settings.field_function | default: "17" }}',
    prior_problem: '{{ section.settings.field_prior_problem | default: "18" }}',
    prior_description: '{{ section.settings.field_prior_description | default: "19" }}',
    treatments: '{{ section.settings.field_treatments | default: "20" }}',
    injection_type: '{{ section.settings.field_injection_type | default: "21" }}',
    surgery_type: '{{ section.settings.field_surgery_type | default: "22" }}',
    treat_helped: '{{ section.settings.field_treat_helped | default: "23" }}',
    treat_duration: '{{ section.settings.field_treat_duration | default: "24" }}',
    treat_stopped: '{{ section.settings.field_treat_stopped | default: "25" }}',
    pmh: '{{ section.settings.field_pmh | default: "26" }}',
    pmh_other_text: '{{ section.settings.field_pmh_other_text | default: "27" }}',
    trauma_yesno: '{{ section.settings.field_trauma_yesno | default: "28" }}',
    trauma_details: '{{ section.settings.field_trauma_details | default: "29" }}',
    past_surgery_any: '{{ section.settings.field_past_surgery_any | default: "30" }}',
    fh_bone_joint: '{{ section.settings.field_fh_bone_joint | default: "31" }}',
    fh_childhood_knee: '{{ section.settings.field_fh_childhood_knee | default: "32" }}',
    fh_details: '{{ section.settings.field_fh_details | default: "33" }}',
    allergies: '{{ section.settings.field_allergies | default: "34" }}',
    meds_list: '{{ section.settings.field_meds_list | default: "35" }}',
    meds_flags: '{{ section.settings.field_meds_flags | default: "36" }}',
    smoker: '{{ section.settings.field_smoker | default: "37" }}',
    alcohol_yesno: '{{ section.settings.field_alcohol_yesno | default: "38" }}',
    alcohol_units: '{{ section.settings.field_alcohol_units | default: "39" }}',
    other_info: '{{ section.settings.field_other_info | default: "40" }}',
    expectations: '{{ section.settings.field_expectations | default: "41" }}',
    ref_source: '{{ section.settings.field_ref_source | default: "42" }}',
    utm_source: '{{ section.settings.field_utm_source | default: "43" }}',
    utm_medium: '{{ section.settings.field_utm_medium | default: "44" }}',
    utm_campaign: '{{ section.settings.field_utm_campaign | default: "45" }}',
    knee_score: '{{ section.settings.field_knee_score | default: "46" }}',
    knee_band: '{{ section.settings.field_knee_band | default: "47" }}'
  };

  // DOM Elements
  const form = document.getElementById('kauForm-' + sectionId);
  const sections = form.querySelectorAll('.kau-section');
  const progressBar = document.getElementById('kauProgress-' + sectionId);
  const stepText = document.getElementById('kauStep-' + sectionId);
  const totalStepsText = document.getElementById('kauTotalSteps-' + sectionId);
  const prevBtn = document.getElementById('kauPrev-' + sectionId);
  const nextBtn = document.getElementById('kauNext-' + sectionId);
  const nav = document.getElementById('kauNav-' + sectionId);
  const loading = document.getElementById('kauLoading-' + sectionId);
  const submitBtn = document.getElementById('kauSubmit-' + sectionId);
  
  let currentSection = 1;
  const totalSections = sections.length;
  
  totalStepsText.textContent = totalSections;
  
  // Initialize UTM params
  function initUTM() {
    const params = new URLSearchParams(window.location.search);
    document.getElementById('kau_utm_source').value = params.get('utm_source') || '';
    document.getElementById('kau_utm_medium').value = params.get('utm_medium') || '';
    document.getElementById('kau_utm_campaign').value = params.get('utm_campaign') || '';
  }
  
  // Update progress
  function updateProgress() {
    const pct = (currentSection / totalSections) * 100;
    progressBar.style.width = pct + '%';
    stepText.textContent = currentSection;
    
    // Update button visibility
    prevBtn.style.display = currentSection > 1 ? 'block' : 'none';
    
    // Hide nav on last section (submit button is in the section)
    if (currentSection === totalSections) {
      nav.style.display = 'none';
    } else {
      nav.style.display = 'flex';
    }
  }
  
  // Show section
  function showSection(num) {
    sections.forEach((s, i) => {
      s.classList.toggle('active', i + 1 === num);
    });
    currentSection = num;
    updateProgress();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  
  // Validate current section
  function validateSection(num) {
    const section = sections[num - 1];
    const requiredInputs = section.querySelectorAll('[required]');
    let valid = true;
    
    requiredInputs.forEach(input => {
      // Remove previous error
      input.classList.remove('error');
      const existingErr = input.parentNode.querySelector('.kau-error-msg');
      if (existingErr) existingErr.remove();
      
      let isValid = true;
      
      if (input.type === 'radio') {
        const name = input.name;
        const checked = section.querySelector('input[name="' + name + '"]:checked');
        if (!checked) isValid = false;
      } else if (input.type === 'checkbox') {
        if (!input.checked) isValid = false;
      } else {
        if (!input.value.trim()) isValid = false;
        // Email validation
        if (input.type === 'email' && input.value) {
          const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRe.test(input.value)) isValid = false;
        }
      }
      
      if (!isValid) {
        valid = false;
        input.classList.add('error');
        const err = document.createElement('p');
        err.className = 'kau-error-msg';
        err.textContent = 'This field is required';
        input.parentNode.appendChild(err);
      }
    });
    
    return valid;
  }
  
  // Calculate knee score
  function calculateScore() {
    const pain = parseInt(document.getElementById('kau_pain').value) || 0;
    const sleep = parseInt(document.getElementById('kau_sleep').value) || 0;
    const swelling = parseInt(document.getElementById('kau_swelling').value) || 0;
    const instability = parseInt(document.getElementById('kau_instability').value) || 0;
    const stiffness = parseInt(document.getElementById('kau_stiffness').value) || 0;
    const stairs = parseInt(document.getElementById('kau_stairs').value) || 0;
    const func = parseInt(document.getElementById('kau_function').value) || 0;
    
    // Normalize to 0-100 (inverted - higher is better)
    const painNorm = (1 - pain / 10) * 100;
    const sleepNorm = (1 - sleep / 10) * 100;
    const swellingNorm = (1 - swelling / 5) * 100;
    const instabilityNorm = (1 - instability / 5) * 100;
    const stiffnessNorm = (1 - stiffness / 5) * 100;
    const stairsNorm = (1 - stairs / 5) * 100;
    const funcNorm = (1 - func / 10) * 100;
    
    // Equal weighting
    const score = Math.round((painNorm + sleepNorm + swellingNorm + instabilityNorm + stiffnessNorm + stairsNorm + funcNorm) / 7);
    
    // Determine band
    let band, bandClass;
    if (score >= 85) {
      band = 'Optimal';
      bandClass = 'band-optimal';
    } else if (score >= 70) {
      band = 'Good';
      bandClass = 'band-green';
    } else if (score >= 60) {
      band = 'Fair';
      bandClass = 'band-amber';
    } else {
      band = 'Pay Attention';
      bandClass = 'band-red';
    }
    
    return { score, band, bandClass };
  }
  
  // Update score display
  function updateScoreDisplay() {
    const { score, band, bandClass } = calculateScore();
    
    // Update preview in section 2
    const preview = document.getElementById('kauScorePreview-' + sectionId);
    const previewValue = document.getElementById('kauScoreValue-' + sectionId);
    const previewBand = document.getElementById('kauScoreBand-' + sectionId);
    
    preview.className = 'kau-score-preview ' + bandClass;
    previewValue.textContent = score;
    previewBand.textContent = band;
    
    // Update final score in section 6
    const final = document.getElementById('kauFinalScore-' + sectionId);
    const finalValue = document.getElementById('kauFinalScoreValue-' + sectionId);
    const finalBand = document.getElementById('kauFinalScoreBand-' + sectionId);
    
    final.className = 'kau-score-preview ' + bandClass;
    finalValue.textContent = score;
    finalBand.textContent = band;
  }
  
  // Slider value display
  document.querySelectorAll('.kau-slider').forEach(slider => {
    const valDisplay = document.getElementById(slider.id + '_val');
    if (valDisplay) {
      slider.addEventListener('input', function() {
        valDisplay.textContent = this.value;
        updateScoreDisplay();
      });
    }
  });
  
  // Progressive disclosure handlers
  function setupConditionalFields() {
    // Prior description
    document.querySelectorAll('input[name="prior_problem"]').forEach(r => {
      r.addEventListener('change', function() {
        document.getElementById('kau_prior_desc_wrap').classList.toggle('hidden', this.value !== 'Yes');
      });
    });
    
    // Treatments - Injections/Surgery
    document.querySelectorAll('input[name="treatments"]').forEach(cb => {
      cb.addEventListener('change', function() {
        const treatments = Array.from(document.querySelectorAll('input[name="treatments"]:checked')).map(c => c.value);
        document.getElementById('kau_injection_wrap').classList.toggle('hidden', !treatments.includes('Injections'));
        document.getElementById('kau_surgery_wrap').classList.toggle('hidden', !treatments.includes('Surgery'));
      });
    });
    
    // Treat duration
    document.querySelectorAll('input[name="treat_helped"]').forEach(r => {
      r.addEventListener('change', function() {
        document.getElementById('kau_treat_duration_wrap').classList.toggle('hidden', this.value !== 'Yes');
      });
    });
    
    // PMH Other
    document.querySelectorAll('input[name="pmh"]').forEach(cb => {
      cb.addEventListener('change', function() {
        const pmh = Array.from(document.querySelectorAll('input[name="pmh"]:checked')).map(c => c.value);
        document.getElementById('kau_pmh_other_wrap').classList.toggle('hidden', !pmh.includes('Other'));
      });
    });
    
    // Trauma details
    document.querySelectorAll('input[name="trauma_yesno"]').forEach(r => {
      r.addEventListener('change', function() {
        document.getElementById('kau_trauma_wrap').classList.toggle('hidden', this.value !== 'Yes');
      });
    });
    
    // Family history details
    function updateFHDetails() {
      const fhBone = document.querySelector('input[name="fh_bone_joint"]:checked');
      const fhChild = document.querySelector('input[name="fh_childhood_knee"]:checked');
      const showFH = (fhBone && fhBone.value === 'Yes') || (fhChild && fhChild.value === 'Yes');
      document.getElementById('kau_fh_details_wrap').classList.toggle('hidden', !showFH);
    }
    document.querySelectorAll('input[name="fh_bone_joint"], input[name="fh_childhood_knee"]').forEach(r => {
      r.addEventListener('change', updateFHDetails);
    });
    
    // Alcohol units
    document.querySelectorAll('input[name="alcohol_yesno"]').forEach(r => {
      r.addEventListener('change', function() {
        document.getElementById('kau_alcohol_wrap').classList.toggle('hidden', this.value !== 'Yes');
      });
    });
  }
  
  // Collect form data
  function collectFormData() {
    const data = {};
    const formData = new FormData(form);
    
    for (const [key, value] of formData.entries()) {
      if (data[key]) {
        // Handle multiple values (checkboxes)
        if (Array.isArray(data[key])) {
          data[key].push(value);
        } else {
          data[key] = [data[key], value];
        }
      } else {
        data[key] = value;
      }
    }
    
    // Add calculated score
    const { score, band } = calculateScore();
    data.knee_score = score;
    data.knee_band = band;
    
    return data;
  }
  
  // Build Jotform prefill URL
  function buildJotformUrl(data) {
    const baseUrl = 'https://form.jotform.com/' + formId;
    const params = new URLSearchParams();
    
    for (const [localKey, value] of Object.entries(data)) {
      const jotformId = fieldMap[localKey];
      if (jotformId && value) {
        if (Array.isArray(value)) {
          // For checkboxes, Jotform uses q{id}[]
          value.forEach(v => params.append('q' + jotformId + '[]', v));
        } else {
          params.append('q' + jotformId, value);
        }
      }
    }
    
    return baseUrl + '?' + params.toString();
  }
  
  // Submit handler
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    
    if (!validateSection(currentSection)) return;
    
    // Show loading
    form.style.display = 'none';
    loading.classList.add('active');
    
    // Collect data
    const data = collectFormData();
    
    // Option 1: Redirect to prefilled Jotform
    const jotformUrl = buildJotformUrl(data);
    window.location.href = jotformUrl;
    
    // Option 2: POST to Jotform API (uncomment if needed)
    /*
    const submitData = new FormData();
    submitData.append('formID', formId);
    for (const [localKey, value] of Object.entries(data)) {
      const jotformId = fieldMap[localKey];
      if (jotformId && value) {
        if (Array.isArray(value)) {
          value.forEach(v => submitData.append('q' + jotformId + '[]', v));
        } else {
          submitData.append('q' + jotformId, value);
        }
      }
    }
    
    fetch(jotformBaseUrl + '/' + formId, {
      method: 'POST',
      body: submitData
    })
    .then(response => {
      if (response.ok) {
        window.location.href = '/pages/assessment-complete';
      } else {
        throw new Error('Submission failed');
      }
    })
    .catch(err => {
      loading.classList.remove('active');
      form.style.display = 'block';
      alert('There was an error submitting your assessment. Please try again.');
    });
    */
  });
  
  // Navigation handlers
  nextBtn.addEventListener('click', function() {
    if (validateSection(currentSection) && currentSection < totalSections) {
      showSection(currentSection + 1);
    }
  });
  
  prevBtn.addEventListener('click', function() {
    if (currentSection > 1) {
      showSection(currentSection - 1);
    }
  });
  
  // Initialize
  initUTM();
  setupConditionalFields();
  updateProgress();
  updateScoreDisplay();
})();
</script>

