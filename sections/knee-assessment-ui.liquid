{% comment %}
  Knee Assessment UI - Quiz-Style Section (Sportshealing × OmKneeHealth)
  =======================================================================
  Premium, clinician-grade knee assessment questionnaire.
  
  CRITICAL: NO PHI STORAGE
  - No Shopify metafields, customer notes, cart attributes
  - No localStorage, cookies, or analytics payloads with health data
  - Answers exist only in JS memory during session
  - Submitted directly to Jotform via prefill URL
  
  Setup:
  1. Add to sections/knee-assessment-ui.liquid
  2. Create templates/page.knee-assessment.json:
     { "sections": { "main": { "type": "knee-assessment-ui" } }, "order": ["main"] }
  3. Create page at /pages/knee-assessment
  4. Configure Jotform settings in Theme Editor
{% endcomment %}

{%- liquid
  assign section_id = section.id | default: 'kau'
  assign form_id = section.settings.jotform_form_id | default: 'PLACEHOLDER_FORM_ID'
  assign prefill_map = section.settings.jotform_prefill_map_json | default: '{}' 
  assign booking_link = section.settings.booking_link | default: '#'
  assign redirect_url = section.settings.redirect_url | default: '/pages/next-steps-knee'
-%}

{%- capture seo_title -%}{{ section.settings.seo_title | default: 'Knee Assessment Questionnaire | OmKneeHealth' }}{%- endcapture -%}
{%- capture seo_description -%}{{ section.settings.seo_description | default: 'Complete our clinician-designed knee assessment in 4–6 minutes to help guide next steps. UK GDPR-aligned and secure.' }}{%- endcapture -%}

{% if template.name == 'page' %}
<title>{{ seo_title }}</title>
<meta name="description" content="{{ seo_description }}">
<meta property="og:title" content="{{ section.settings.og_title | default: 'Knee Assessment Questionnaire' }}">
<meta property="og:description" content="{{ section.settings.og_description | default: 'A secure, clinician-designed knee assessment to guide your next steps.' }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ canonical_url }}">
<link rel="canonical" href="{{ canonical_url }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": {{ seo_title | json }},
  "description": {{ seo_description | json }},
  "publisher": { "@type": "Organization", "name": "OmKneeHealth" }
}
</script>
{% endif %}

<style>
/* =====================================================
   PREMIUM CLINICAL DESIGN SYSTEM
   Calm, clinic-grade aesthetic with excellent mobile UX
   ===================================================== */

#kau-{{ section_id }} {
  /* Primary palette - calm clinical greens */
  --kau-primary: {{ section.settings.primary_color | default: '#166534' }};
  --kau-primary-light: {{ section.settings.primary_light | default: '#dcfce7' }};
  --kau-primary-subtle: #f0fdf4;
  --kau-secondary: {{ section.settings.secondary_color | default: '#0369a1' }};
  
  /* Status colors - accessible contrast */
  --kau-danger: #b91c1c;
  --kau-danger-light: #fef2f2;
  --kau-danger-border: #fecaca;
  --kau-amber: #b45309;
  --kau-amber-light: #fffbeb;
  --kau-amber-border: #fde68a;
  --kau-green: #15803d;
  --kau-green-light: #f0fdf4;
  --kau-green-border: #bbf7d0;
  --kau-optimal: #0369a1;
  --kau-optimal-light: #e0f2fe;
  --kau-optimal-border: #bae6fd;
  
  /* Neutral palette */
  --kau-text: #1e293b;
  --kau-text-secondary: #475569;
  --kau-text-muted: #64748b;
  --kau-text-subtle: #94a3b8;
  --kau-bg: #ffffff;
  --kau-bg-alt: #f8fafc;
  --kau-bg-elevated: #ffffff;
  --kau-border: #e2e8f0;
  --kau-border-light: #f1f5f9;
  
  /* Spacing & sizing */
  --kau-radius: 16px;
  --kau-radius-sm: 12px;
  --kau-radius-lg: 20px;
  --kau-shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --kau-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.07), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
  --kau-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -4px rgba(0, 0, 0, 0.05);
  --kau-shadow-card: 0 1px 3px 0 rgba(0, 0, 0, 0.04), 0 1px 2px -1px rgba(0, 0, 0, 0.04);
  
  /* Typography */
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  font-size: 16px;
  line-height: 1.65;
  color: var(--kau-text);
  background: linear-gradient(180deg, var(--kau-bg) 0%, var(--kau-bg-alt) 100%);
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#kau-{{ section_id }} * { box-sizing: border-box; }

/* Container - generous whitespace */
.kau-container {
  max-width: 680px;
  margin: 0 auto;
  padding: 32px 20px 80px;
}

@media (min-width: 768px) {
  .kau-container {
    padding: 64px 48px 100px;
  }
}

/* ===== HERO ===== */
.kau-hero {
  text-align: center;
  margin-bottom: 40px;
  padding-bottom: 32px;
  border-bottom: 1px solid var(--kau-border-light);
}

.kau-hero__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 18px;
  background: linear-gradient(135deg, var(--kau-primary) 0%, var(--kau-secondary) 100%);
  color: #fff;
  font-size: 0.6875rem;
  font-weight: 700;
  border-radius: 100px;
  margin-bottom: 20px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  box-shadow: var(--kau-shadow);
}

.kau-hero__title {
  font-size: clamp(1.625rem, 5vw, 2.25rem);
  font-weight: 700;
  margin: 0 0 12px;
  color: var(--kau-text);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.kau-hero__subtitle {
  font-size: 1.0625rem;
  color: var(--kau-text-secondary);
  margin: 0;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.6;
}

.kau-hero__subtitle strong {
  color: var(--kau-primary);
  font-weight: 600;
}

/* ===== TRUST BAR ===== */
.kau-trust-bar {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px 24px;
  padding: 18px 24px;
  background: var(--kau-bg-elevated);
  border: 1px solid var(--kau-border-light);
  border-radius: var(--kau-radius);
  margin-bottom: 28px;
  box-shadow: var(--kau-shadow-card);
}

.kau-trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--kau-text-secondary);
}

.kau-trust-item svg {
  width: 18px;
  height: 18px;
  color: var(--kau-primary);
}

/* ===== INFO PANEL ===== */
.kau-info-panel {
  background: var(--kau-primary-subtle);
  border: 1px solid var(--kau-green-border);
  border-radius: var(--kau-radius);
  padding: 20px 24px;
  margin-bottom: 28px;
}

.kau-info-panel p {
  font-size: 0.9375rem;
  color: var(--kau-text-secondary);
  margin: 0;
  line-height: 1.6;
}

/* ===== FAQ ===== */
.kau-faq {
  margin-bottom: 40px;
}

.kau-faq__title {
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin: 0 0 16px;
  color: var(--kau-text-muted);
}

.kau-faq-item {
  border: 1px solid var(--kau-border);
  border-radius: var(--kau-radius-sm);
  margin-bottom: 10px;
  overflow: hidden;
  background: var(--kau-bg-elevated);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.kau-faq-item:hover {
  border-color: var(--kau-primary);
}

.kau-faq-item summary {
  padding: 16px 20px;
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--kau-text);
  cursor: pointer;
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: background 0.2s;
}

.kau-faq-item summary:hover {
  background: var(--kau-bg-alt);
}

.kau-faq-item summary::-webkit-details-marker { display: none; }

.kau-faq-item summary::after {
  content: '+';
  font-size: 1.375rem;
  font-weight: 300;
  color: var(--kau-text-subtle);
  transition: transform 0.2s;
}

.kau-faq-item[open] summary::after {
  content: '−';
  color: var(--kau-primary);
}

.kau-faq-item__content {
  padding: 0 20px 20px;
  font-size: 0.875rem;
  color: var(--kau-text-muted);
  line-height: 1.7;
}

/* ===== PROGRESS ===== */
.kau-progress {
  margin-bottom: 40px;
  background: var(--kau-bg-elevated);
  padding: 24px;
  border-radius: var(--kau-radius);
  border: 1px solid var(--kau-border-light);
  box-shadow: var(--kau-shadow-card);
}

.kau-progress__bar-wrap {
  height: 10px;
  background: var(--kau-border);
  border-radius: 100px;
  overflow: hidden;
  margin-bottom: 16px;
}

.kau-progress__bar {
  height: 100%;
  background: linear-gradient(90deg, var(--kau-primary) 0%, var(--kau-secondary) 100%);
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 100px;
}

.kau-progress__steps {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6px;
}

.kau-progress__step {
  font-size: 0.6875rem;
  font-weight: 600;
  color: var(--kau-text-subtle);
  padding: 6px 12px;
  border-radius: 100px;
  background: var(--kau-bg-alt);
  border: 1px solid transparent;
  transition: all 0.25s ease;
  white-space: nowrap;
}

.kau-progress__step.active {
  background: var(--kau-primary);
  color: #fff;
  box-shadow: var(--kau-shadow);
}

.kau-progress__step.done {
  background: var(--kau-primary-light);
  color: var(--kau-primary);
  border-color: var(--kau-green-border);
}

.kau-progress__pct {
  text-align: center;
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--kau-text-muted);
  margin-top: 12px;
}

/* ===== SECTIONS / CARDS ===== */
.kau-section {
  display: none;
  animation: kauFade 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.kau-section.active {
  display: block;
}

@keyframes kauFade {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

.kau-section__title {
  font-size: 1.375rem;
  font-weight: 700;
  margin: 0 0 10px;
  color: var(--kau-text);
  letter-spacing: -0.01em;
}

.kau-section__desc {
  font-size: 1rem;
  color: var(--kau-text-muted);
  margin: 0 0 32px;
  line-height: 1.6;
}

/* ===== FORM ELEMENTS ===== */
.kau-field {
  margin-bottom: 28px;
}

.kau-field.hidden {
  display: none !important;
}

.kau-label {
  display: block;
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--kau-text);
  margin-bottom: 10px;
}

.kau-label--required::after {
  content: ' *';
  color: var(--kau-danger);
  font-weight: 500;
}

.kau-input, .kau-select, .kau-textarea {
  width: 100%;
  padding: 16px 20px;
  font-size: 1rem;
  border: 2px solid var(--kau-border);
  border-radius: var(--kau-radius);
  background: var(--kau-bg-elevated);
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  color: var(--kau-text);
}

.kau-input::placeholder, .kau-textarea::placeholder {
  color: var(--kau-text-subtle);
}

.kau-input:hover, .kau-select:hover, .kau-textarea:hover {
  border-color: var(--kau-text-subtle);
}

.kau-input:focus, .kau-select:focus, .kau-textarea:focus {
  outline: none;
  border-color: var(--kau-primary);
  box-shadow: 0 0 0 4px var(--kau-primary-light);
  background: var(--kau-bg);
}

.kau-input.error, .kau-select.error, .kau-textarea.error {
  border-color: var(--kau-danger);
  background: var(--kau-danger-light);
}

.kau-error-msg {
  font-size: 0.8125rem;
  font-weight: 500;
  color: var(--kau-danger);
  margin-top: 8px;
  display: flex;
  align-items: center;
  gap: 6px;
}

.kau-hint {
  font-size: 0.8125rem;
  color: var(--kau-text-muted);
  margin-top: 8px;
  line-height: 1.5;
}

.kau-textarea {
  min-height: 120px;
  resize: vertical;
  font-family: inherit;
  line-height: 1.6;
}

.kau-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

@media (max-width: 480px) {
  .kau-row { grid-template-columns: 1fr; }
}

/* ===== SLIDERS - Touch-Optimized for iPhone ===== */
.kau-slider-card {
  background: var(--kau-bg-elevated);
  border: 1px solid var(--kau-border-light);
  border-radius: var(--kau-radius);
  padding: 24px;
  margin-bottom: 20px;
  box-shadow: var(--kau-shadow-card);
  transition: border-color 0.2s, box-shadow 0.2s;
}

.kau-slider-card:hover {
  border-color: var(--kau-border);
}

.kau-slider-card:focus-within {
  border-color: var(--kau-primary);
  box-shadow: 0 0 0 4px var(--kau-primary-light);
}

.kau-slider-wrap {
  padding: 12px 0 8px;
}

.kau-slider-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
  gap: 16px;
}

.kau-slider-header .kau-label {
  margin-bottom: 0;
  flex: 1;
}

.kau-slider-value {
  font-size: 2rem;
  font-weight: 800;
  color: var(--kau-primary);
  min-width: 56px;
  text-align: center;
  background: var(--kau-primary-light);
  padding: 8px 16px;
  border-radius: var(--kau-radius-sm);
  line-height: 1;
}

.kau-slider {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 12px;
  background: linear-gradient(to right, var(--kau-primary-light) 0%, var(--kau-border) 100%);
  border-radius: 100px;
  outline: none;
  cursor: pointer;
  /* Touch-friendly: larger hit area */
  padding: 16px 0;
  margin: -16px 0;
  background-clip: content-box;
}

.kau-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 36px;
  height: 36px;
  background: var(--kau-primary);
  border-radius: 50%;
  cursor: pointer;
  box-shadow: 0 2px 8px rgba(22, 101, 52, 0.3), 0 0 0 4px rgba(22, 101, 52, 0.1);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  border: 4px solid #fff;
}

.kau-slider::-webkit-slider-thumb:hover {
  transform: scale(1.1);
  box-shadow: 0 4px 12px rgba(22, 101, 52, 0.4), 0 0 0 6px rgba(22, 101, 52, 0.15);
}

.kau-slider::-webkit-slider-thumb:active {
  transform: scale(1.15);
}

.kau-slider::-moz-range-thumb {
  width: 36px;
  height: 36px;
  background: var(--kau-primary);
  border-radius: 50%;
  cursor: pointer;
  border: 4px solid #fff;
  box-shadow: 0 2px 8px rgba(22, 101, 52, 0.3);
}

.kau-slider-labels {
  display: flex;
  justify-content: space-between;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--kau-text-subtle);
  margin-top: 12px;
  padding: 0 4px;
}

.kau-slider-labels span:first-child {
  color: var(--kau-green);
}

.kau-slider-labels span:last-child {
  color: var(--kau-amber);
}

/* Mobile slider enhancements */
@media (max-width: 480px) {
  .kau-slider-card {
    padding: 20px;
    margin-bottom: 16px;
  }
  
  .kau-slider-header {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }
  
  .kau-slider-value {
    align-self: flex-end;
    font-size: 1.75rem;
    padding: 6px 14px;
  }
  
  .kau-slider {
    height: 14px;
  }
  
  .kau-slider::-webkit-slider-thumb {
    width: 44px;
    height: 44px;
  }
  
  .kau-slider::-moz-range-thumb {
    width: 44px;
    height: 44px;
  }
}

/* ===== RADIO / CHECKBOX OPTIONS ===== */
.kau-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.kau-option {
  position: relative;
}

.kau-option input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

.kau-option__label {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 24px;
  background: var(--kau-bg-elevated);
  border: 2px solid var(--kau-border);
  border-radius: var(--kau-radius);
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--kau-text-secondary);
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 56px;
}

.kau-option__label:hover {
  border-color: var(--kau-text-subtle);
  background: var(--kau-bg-alt);
}

.kau-option input:checked + .kau-option__label {
  background: var(--kau-primary-light);
  border-color: var(--kau-primary);
  color: var(--kau-primary);
  box-shadow: var(--kau-shadow-sm);
}

.kau-option input:focus + .kau-option__label {
  box-shadow: 0 0 0 4px var(--kau-primary-light);
}

/* Checkbox grid */
.kau-checkbox-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 12px;
}

.kau-checkbox {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 18px;
  background: var(--kau-bg-elevated);
  border: 2px solid var(--kau-border);
  border-radius: var(--kau-radius);
  cursor: pointer;
  transition: all 0.2s ease;
  min-height: 56px;
}

.kau-checkbox:hover {
  border-color: var(--kau-text-subtle);
  background: var(--kau-bg-alt);
}

.kau-checkbox.checked {
  background: var(--kau-primary-light);
  border-color: var(--kau-primary);
}

.kau-checkbox input {
  width: 22px;
  height: 22px;
  margin: 0;
  accent-color: var(--kau-primary);
  flex-shrink: 0;
  cursor: pointer;
}

.kau-checkbox span {
  font-size: 0.9375rem;
  font-weight: 500;
  line-height: 1.4;
  color: var(--kau-text-secondary);
}

.kau-checkbox.checked span {
  color: var(--kau-primary);
}

/* ===== CONSENT BOXES ===== */
.kau-consent {
  background: var(--kau-bg-elevated);
  border: 2px solid var(--kau-border);
  border-radius: var(--kau-radius);
  padding: 24px;
  margin-bottom: 20px;
  transition: border-color 0.2s;
}

.kau-consent.required {
  border-color: var(--kau-primary);
  background: var(--kau-primary-subtle);
}

.kau-consent__header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.kau-consent__title {
  font-weight: 700;
  font-size: 1rem;
  color: var(--kau-text);
}

.kau-consent__badge {
  font-size: 0.6875rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 100px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.kau-consent__badge.required {
  background: var(--kau-danger-light);
  color: var(--kau-danger);
}

.kau-consent__badge.optional {
  background: var(--kau-bg-alt);
  color: var(--kau-text-muted);
  border: 1px solid var(--kau-border);
}

.kau-consent label {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  cursor: pointer;
}

.kau-consent input {
  width: 24px;
  height: 24px;
  margin-top: 2px;
  accent-color: var(--kau-primary);
  flex-shrink: 0;
  cursor: pointer;
}

.kau-consent p {
  font-size: 0.9375rem;
  color: var(--kau-text-secondary);
  margin: 0;
  line-height: 1.6;
}

/* ===== SCORE PREVIEW ===== */
.kau-score-preview {
  background: var(--kau-bg-elevated);
  border: 2px solid var(--kau-border);
  border-radius: var(--kau-radius-lg);
  padding: 32px;
  margin-bottom: 28px;
  text-align: center;
  box-shadow: var(--kau-shadow);
}

.kau-score-preview__label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--kau-text-muted);
  margin-bottom: 12px;
}

.kau-score-preview__value {
  font-size: 4rem;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 12px;
  letter-spacing: -0.02em;
}

.kau-score-preview__band {
  display: inline-block;
  padding: 10px 28px;
  border-radius: 100px;
  font-size: 0.875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.kau-score-preview__note {
  font-size: 0.8125rem;
  color: var(--kau-text-muted);
  margin-top: 16px;
  line-height: 1.5;
}

/* Score bands */
.kau-score-preview.band-red {
  border-color: var(--kau-danger-border);
  background: var(--kau-danger-light);
}
.kau-score-preview.band-red .kau-score-preview__value { color: var(--kau-danger); }
.kau-score-preview.band-red .kau-score-preview__band { background: var(--kau-danger); color: #fff; }

.kau-score-preview.band-amber {
  border-color: var(--kau-amber-border);
  background: var(--kau-amber-light);
}
.kau-score-preview.band-amber .kau-score-preview__value { color: var(--kau-amber); }
.kau-score-preview.band-amber .kau-score-preview__band { background: var(--kau-amber); color: #fff; }

.kau-score-preview.band-green {
  border-color: var(--kau-green-border);
  background: var(--kau-green-light);
}
.kau-score-preview.band-green .kau-score-preview__value { color: var(--kau-green); }
.kau-score-preview.band-green .kau-score-preview__band { background: var(--kau-green); color: #fff; }

.kau-score-preview.band-optimal {
  border-color: var(--kau-optimal-border);
  background: var(--kau-optimal-light);
}
.kau-score-preview.band-optimal .kau-score-preview__value { color: var(--kau-optimal); }
.kau-score-preview.band-optimal .kau-score-preview__band { background: var(--kau-optimal); color: #fff; }

/* ===== REVIEW SUMMARY ===== */
.kau-review {
  background: var(--kau-bg-elevated);
  border: 1px solid var(--kau-border-light);
  border-radius: var(--kau-radius);
  padding: 28px;
  margin-bottom: 28px;
  box-shadow: var(--kau-shadow-card);
}

.kau-review__title {
  font-size: 1rem;
  font-weight: 700;
  margin: 0 0 20px;
  color: var(--kau-text);
}

.kau-review__group {
  margin-bottom: 20px;
  padding-bottom: 20px;
  border-bottom: 1px solid var(--kau-border-light);
}

.kau-review__group:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.kau-review__group-title {
  font-size: 0.6875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--kau-text-subtle);
  margin-bottom: 12px;
}

.kau-review__item {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  font-size: 0.9375rem;
}

.kau-review__item-label {
  color: var(--kau-text-muted);
}

.kau-review__item-value {
  font-weight: 600;
  color: var(--kau-text);
  text-align: right;
  max-width: 55%;
}

/* ===== NAVIGATION BUTTONS ===== */
.kau-nav {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 40px;
  padding-top: 32px;
  border-top: 1px solid var(--kau-border-light);
}

.kau-btn {
  padding: 18px 32px;
  font-size: 1rem;
  font-weight: 700;
  border-radius: var(--kau-radius);
  cursor: pointer;
  transition: all 0.2s ease;
  border: none;
  min-height: 60px;
}

.kau-btn--secondary {
  background: var(--kau-bg-elevated);
  color: var(--kau-text-secondary);
  border: 2px solid var(--kau-border);
}

.kau-btn--secondary:hover {
  background: var(--kau-bg-alt);
  border-color: var(--kau-text-subtle);
}

.kau-btn--primary {
  background: var(--kau-primary);
  color: #fff;
  flex: 1;
  max-width: 220px;
  margin-left: auto;
  box-shadow: var(--kau-shadow);
}

.kau-btn--primary:hover {
  background: #14532d;
  transform: translateY(-1px);
  box-shadow: var(--kau-shadow-lg);
}

.kau-btn--primary:active {
  transform: translateY(0);
}

.kau-btn--primary:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.kau-btn--submit {
  width: 100%;
  max-width: none;
  padding: 22px 40px;
  font-size: 1.125rem;
  background: linear-gradient(135deg, var(--kau-primary) 0%, var(--kau-secondary) 100%);
  box-shadow: 0 4px 14px rgba(22, 101, 52, 0.3);
}

.kau-btn--submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(22, 101, 52, 0.4);
}

/* ===== LOADING STATE ===== */
.kau-loading {
  display: none;
  text-align: center;
  padding: 80px 20px;
}

.kau-loading.active {
  display: block;
}

.kau-spinner {
  width: 56px;
  height: 56px;
  border: 4px solid var(--kau-border);
  border-top-color: var(--kau-primary);
  border-radius: 50%;
  animation: kauSpin 0.8s linear infinite;
  margin: 0 auto 20px;
}

@keyframes kauSpin {
  to { transform: rotate(360deg); }
}

.kau-loading p {
  font-size: 1rem;
  font-weight: 600;
  color: var(--kau-text-secondary);
}

/* ===== URGENT WARNING ===== */
.kau-urgent {
  background: var(--kau-danger-light);
  border: 2px solid var(--kau-danger-border);
  border-radius: var(--kau-radius);
  padding: 20px 24px;
  margin-top: 28px;
  display: flex;
  gap: 16px;
  align-items: flex-start;
}

.kau-urgent svg {
  width: 24px;
  height: 24px;
  color: var(--kau-danger);
  flex-shrink: 0;
  margin-top: 2px;
}

.kau-urgent p {
  font-size: 0.9375rem;
  color: var(--kau-danger);
  margin: 0;
  line-height: 1.6;
}

.kau-urgent strong {
  font-weight: 700;
}

/* ===== MOBILE OPTIMIZATIONS ===== */
@media (max-width: 480px) {
  .kau-container {
    padding: 24px 16px 60px;
  }
  
  .kau-hero {
    margin-bottom: 28px;
    padding-bottom: 24px;
  }
  
  .kau-hero__title {
    font-size: 1.5rem;
  }
  
  .kau-trust-bar {
    padding: 14px 16px;
    gap: 8px 16px;
  }
  
  .kau-trust-item {
    font-size: 0.8125rem;
  }
  
  .kau-progress {
    padding: 18px;
    margin-bottom: 28px;
  }
  
  .kau-progress__steps {
    display: none; /* Hide step labels on mobile, show progress bar only */
  }
  
  .kau-section__title {
    font-size: 1.25rem;
  }
  
  .kau-field {
    margin-bottom: 24px;
  }
  
  .kau-input, .kau-select, .kau-textarea {
    padding: 14px 16px;
    font-size: 16px; /* Prevent iOS zoom */
  }
  
  .kau-options {
    flex-direction: column;
  }
  
  .kau-option__label {
    width: 100%;
    justify-content: center;
    padding: 18px 20px;
  }
  
  .kau-checkbox-grid {
    grid-template-columns: 1fr;
  }
  
  .kau-checkbox {
    padding: 18px 16px;
  }
  
  .kau-consent {
    padding: 20px;
  }
  
  .kau-nav {
    flex-direction: column;
    gap: 12px;
    margin-top: 32px;
    padding-top: 24px;
  }
  
  .kau-btn {
    width: 100%;
    max-width: none;
  }
  
  .kau-btn--primary {
    order: -1; /* Primary button first on mobile */
  }
  
  .kau-score-preview {
    padding: 24px 20px;
  }
  
  .kau-score-preview__value {
    font-size: 3rem;
  }
}

/* Urgent Warning */
.kau-urgent { background: var(--kau-danger-light); border: 1px solid #fca5a5; border-radius: var(--kau-radius); padding: 16px; margin-top: 24px; display: flex; gap: 12px; align-items: flex-start; }
.kau-urgent svg { width: 20px; height: 20px; color: var(--kau-danger); flex-shrink: 0; margin-top: 1px; }
.kau-urgent p { font-size: 0.875rem; color: #991b1b; margin: 0; line-height: 1.5; }
</style>

<section id="kau-{{ section_id }}" aria-label="Knee Assessment Questionnaire">
<div class="kau-container">

<!-- Hero -->
<header class="kau-hero">
  <span class="kau-hero__badge">Sportshealing × OmKneeHealth</span>
  <h1 class="kau-hero__title">{{ section.settings.heading | default: 'Full Knee Assessment' }}</h1>
  <p class="kau-hero__subtitle">{{ section.settings.subheading | default: 'Clinician-designed by <strong>Sportshealing</strong>. Powered by <strong>OmKneeHealth</strong>.' }}</p>
</header>

<!-- Trust Bar -->
<div class="kau-trust-bar">
  <span class="kau-trust-item"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>UK GDPR-aligned</span>
  <span class="kau-trust-item"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>Secure</span>
  <span class="kau-trust-item"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Takes 4–6 minutes</span>
</div>

<!-- Info Panel -->
<div class="kau-info-panel">
  <p>We use your answers to guide next steps and relevant recommendations. Marketing is opt-in only.</p>
</div>

<!-- FAQ -->
<div class="kau-faq">
  <h2 class="kau-faq__title">Common Questions</h2>
  <details class="kau-faq-item"><summary>How is my data used?</summary><div class="kau-faq-item__content">Your responses are processed to generate personalised knee health guidance. Data is stored securely on UK/EU servers via Jotform Enterprise. We never sell your data to third parties.</div></details>
  <details class="kau-faq-item"><summary>How long is my data kept?</summary><div class="kau-faq-item__content">Assessment data is retained for up to 24 months to track your progress. Marketing preferences are kept until you unsubscribe. You can request earlier deletion at any time.</div></details>
  <details class="kau-faq-item"><summary>Can I request deletion?</summary><div class="kau-faq-item__content">Yes. Under UK GDPR, you can request deletion by emailing privacy@omkneehealth.com. We will process your request within 30 days.</div></details>
  <details class="kau-faq-item"><summary>What if I have urgent symptoms?</summary><div class="kau-faq-item__content">If your knee is acutely swollen, hot, red, or you cannot bear weight, please seek urgent medical attention rather than completing this questionnaire.</div></details>
</div>

<!-- Compliance Block -->
{% render 'knee-assessment-compliance', 
  section_id: section.id,
  privacy_link: section.settings.privacy_link,
  deletion_link: section.settings.deletion_link
%}

<!-- Progress -->
<div class="kau-progress">
  <div class="kau-progress__bar-wrap"><div class="kau-progress__bar" id="kauProgressBar-{{ section_id }}" style="width:0%"></div></div>
  <div class="kau-progress__steps" id="kauStepLabels-{{ section_id }}">
    <span class="kau-progress__step active" data-step="1">Details</span>
    <span class="kau-progress__step" data-step="2">Symptoms</span>
    <span class="kau-progress__step" data-step="3">History</span>
    <span class="kau-progress__step" data-step="4">Medical</span>
    <span class="kau-progress__step" data-step="5">Meds</span>
    <span class="kau-progress__step" data-step="6">Lifestyle</span>
    <span class="kau-progress__step" data-step="7">Goals</span>
    <span class="kau-progress__step" data-step="8">Review</span>
    <span class="kau-progress__step" data-step="9">Submit</span>
  </div>
  <p class="kau-progress__pct"><span id="kauPct-{{ section_id }}">0</span>% complete</p>
</div>

<form id="kauForm-{{ section_id }}" novalidate>

<!-- STEP 1: Patient Details -->
<div class="kau-section active" data-step="1">
  <h2 class="kau-section__title">Your Details</h2>
  <p class="kau-section__desc">Basic information to personalise your assessment.</p>
  <div class="kau-row">
    <div class="kau-field"><label class="kau-label kau-label--required" for="kau_first_name">First Name</label><input type="text" id="kau_first_name" name="first_name" class="kau-input" required maxlength="50" autocomplete="given-name"></div>
    <div class="kau-field"><label class="kau-label kau-label--required" for="kau_last_name">Last Name</label><input type="text" id="kau_last_name" name="last_name" class="kau-input" required maxlength="50" autocomplete="family-name"></div>
  </div>
  <div class="kau-field"><label class="kau-label kau-label--required" for="kau_dob">Date of Birth</label><input type="date" id="kau_dob" name="dob" class="kau-input" required></div>
  <div class="kau-field"><label class="kau-label kau-label--required" for="kau_email">Email Address</label><input type="email" id="kau_email" name="email" class="kau-input" required maxlength="100" autocomplete="email"></div>
  <div class="kau-row">
    <div class="kau-field"><label class="kau-label" for="kau_mobile">Mobile Number</label><input type="tel" id="kau_mobile" name="mobile" class="kau-input" maxlength="20" autocomplete="tel"></div>
    <div class="kau-field"><label class="kau-label" for="kau_postcode">Postcode</label><input type="text" id="kau_postcode" name="postcode" class="kau-input" maxlength="10" autocomplete="postal-code"></div>
  </div>
</div>

<!-- STEP 2: Symptoms -->
<div class="kau-section" data-step="2">
  <h2 class="kau-section__title">Your Knee Symptoms</h2>
  <p class="kau-section__desc">Rate each symptom based on the past 7 days. Drag the slider to set your score.</p>
  
  <div class="kau-slider-card">
    <div class="kau-slider-header">
      <label class="kau-label kau-label--required">Pain Level</label>
      <span class="kau-slider-value" id="kau_pain_val">0</span>
    </div>
    <div class="kau-slider-wrap">
      <input type="range" id="kau_pain" name="pain" class="kau-slider" min="0" max="10" value="0">
    </div>
    <div class="kau-slider-labels"><span>0 - No pain</span><span>10 - Severe</span></div>
  </div>

  <div class="kau-slider-card">
    <div class="kau-slider-header">
      <label class="kau-label kau-label--required">Sleep Disturbance</label>
      <span class="kau-slider-value" id="kau_sleep_val">0</span>
    </div>
    <div class="kau-slider-wrap">
      <input type="range" id="kau_sleep" name="sleep" class="kau-slider" min="0" max="10" value="0">
    </div>
    <div class="kau-slider-labels"><span>0 - None</span><span>10 - Severe</span></div>
  </div>

  <div class="kau-slider-card">
    <div class="kau-slider-header">
      <label class="kau-label kau-label--required">Swelling</label>
      <span class="kau-slider-value" id="kau_swelling_val">0</span>
    </div>
    <div class="kau-slider-wrap">
      <input type="range" id="kau_swelling" name="swelling" class="kau-slider" min="0" max="5" value="0">
    </div>
    <div class="kau-slider-labels"><span>0 - None</span><span>5 - Severe</span></div>
  </div>

  <div class="kau-slider-card">
    <div class="kau-slider-header">
      <label class="kau-label kau-label--required">Instability / Giving Way</label>
      <span class="kau-slider-value" id="kau_instability_val">0</span>
    </div>
    <div class="kau-slider-wrap">
      <input type="range" id="kau_instability" name="instability" class="kau-slider" min="0" max="5" value="0">
    </div>
    <div class="kau-slider-labels"><span>0 - Stable</span><span>5 - Very unstable</span></div>
  </div>

  <div class="kau-slider-card">
    <div class="kau-slider-header">
      <label class="kau-label kau-label--required">Stiffness / Restriction</label>
      <span class="kau-slider-value" id="kau_stiffness_val">0</span>
    </div>
    <div class="kau-slider-wrap">
      <input type="range" id="kau_stiffness" name="stiffness" class="kau-slider" min="0" max="5" value="0">
    </div>
    <div class="kau-slider-labels"><span>0 - None</span><span>5 - Severe</span></div>
  </div>

  <div class="kau-slider-card">
    <div class="kau-slider-header">
      <label class="kau-label kau-label--required">Difficulty with Stairs</label>
      <span class="kau-slider-value" id="kau_stairs_val">0</span>
    </div>
    <div class="kau-slider-wrap">
      <input type="range" id="kau_stairs" name="stairs" class="kau-slider" min="0" max="5" value="0">
    </div>
    <div class="kau-slider-labels"><span>0 - None</span><span>5 - Unable</span></div>
  </div>

  <div class="kau-slider-card">
    <div class="kau-slider-header">
      <label class="kau-label kau-label--required">Overall Function</label>
      <span class="kau-slider-value" id="kau_function_val">0</span>
    </div>
    <div class="kau-slider-wrap">
      <input type="range" id="kau_function" name="function" class="kau-slider" min="0" max="10" value="0">
    </div>
    <div class="kau-slider-labels"><span>0 - Normal</span><span>10 - Severely limited</span></div>
  </div>
</div>

<!-- STEP 3: Prior Knee + Treatment -->
<div class="kau-section" data-step="3">
  <h2 class="kau-section__title">Previous Knee Problems</h2>
  <p class="kau-section__desc">Tell us about any previous issues and treatments.</p>
  
  <div class="kau-field">
    <label class="kau-label kau-label--required">Have you had a previous knee problem?</label>
    <div class="kau-options">
      <label class="kau-option"><input type="radio" name="prior_problem" value="Yes" required><span class="kau-option__label">Yes</span></label>
      <label class="kau-option"><input type="radio" name="prior_problem" value="No"><span class="kau-option__label">No</span></label>
    </div>
  </div>
  <div class="kau-field hidden" id="kau_prior_desc_wrap">
    <label class="kau-label" for="kau_prior_description">Please describe</label>
    <textarea id="kau_prior_description" name="prior_description" class="kau-textarea" maxlength="500" placeholder="e.g., ACL tear in 2018..."></textarea>
  </div>
  
  <div class="kau-field">
    <label class="kau-label">What treatments have you tried?</label>
    <div class="kau-checkbox-grid" id="kau_treatments_grid">
      <label class="kau-checkbox"><input type="checkbox" name="treatments" value="Physiotherapy"><span>Physiotherapy</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="treatments" value="Medication"><span>Medication</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="treatments" value="Injections"><span>Injections</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="treatments" value="Surgery"><span>Surgery</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="treatments" value="Supplements"><span>Supplements</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="treatments" value="None"><span>None</span></label>
    </div>
  </div>
  <div class="kau-field hidden" id="kau_injection_wrap">
    <label class="kau-label" for="kau_injection_type">Injection type?</label>
    <select id="kau_injection_type" name="injection_type" class="kau-select"><option value="">Select...</option><option value="Steroid">Steroid</option><option value="Hyaluronic acid">Hyaluronic acid</option><option value="PRP">PRP</option><option value="Stem cell">Stem cell</option><option value="Other">Other</option></select>
  </div>
  <div class="kau-field hidden" id="kau_surgery_wrap">
    <label class="kau-label" for="kau_surgery_type">Surgery type?</label>
    <select id="kau_surgery_type" name="surgery_type" class="kau-select"><option value="">Select...</option><option value="Arthroscopy">Arthroscopy</option><option value="ACL reconstruction">ACL reconstruction</option><option value="Meniscectomy">Meniscectomy</option><option value="Partial replacement">Partial replacement</option><option value="Total replacement">Total replacement</option><option value="Other">Other</option></select>
  </div>
  
  <div class="kau-field">
    <label class="kau-label">Did any treatment help?</label>
    <div class="kau-options">
      <label class="kau-option"><input type="radio" name="treat_helped" value="Yes"><span class="kau-option__label">Yes</span></label>
      <label class="kau-option"><input type="radio" name="treat_helped" value="No"><span class="kau-option__label">No</span></label>
      <label class="kau-option"><input type="radio" name="treat_helped" value="Partially"><span class="kau-option__label">Partially</span></label>
    </div>
  </div>
  <div class="kau-field hidden" id="kau_treat_duration_wrap">
    <label class="kau-label" for="kau_treat_duration">How long did benefit last?</label>
    <select id="kau_treat_duration" name="treat_duration" class="kau-select"><option value="">Select...</option><option value="Days">A few days</option><option value="Weeks">A few weeks</option><option value="Months">A few months</option><option value="6+ months">6+ months</option><option value="Still helping">Still helping</option></select>
  </div>
  <div class="kau-field">
    <label class="kau-label" for="kau_treat_stopped">Why did you stop treatment?</label>
    <input type="text" id="kau_treat_stopped" name="treat_stopped" class="kau-input" maxlength="200" placeholder="e.g., Cost, side effects...">
  </div>
</div>

<!-- STEP 4: PMH -->
<div class="kau-section" data-step="4">
  <h2 class="kau-section__title">Medical History</h2>
  <p class="kau-section__desc">Help us understand your overall health.</p>
  
  <div class="kau-field">
    <label class="kau-label">Do you have any of these conditions?</label>
    <div class="kau-checkbox-grid" id="kau_pmh_grid">
      <label class="kau-checkbox"><input type="checkbox" name="pmh" value="Diabetes"><span>Diabetes</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="pmh" value="Heart disease"><span>Heart disease</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="pmh" value="High blood pressure"><span>High blood pressure</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="pmh" value="Rheumatoid arthritis"><span>Rheumatoid arthritis</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="pmh" value="Gout"><span>Gout</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="pmh" value="Osteoporosis"><span>Osteoporosis</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="pmh" value="Other"><span>Other</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="pmh" value="None"><span>None</span></label>
    </div>
  </div>
  <div class="kau-field hidden" id="kau_pmh_other_wrap">
    <label class="kau-label" for="kau_pmh_other_text">Please specify</label>
    <input type="text" id="kau_pmh_other_text" name="pmh_other_text" class="kau-input" maxlength="200">
  </div>
  
  <div class="kau-field">
    <label class="kau-label">Any significant knee trauma/injury?</label>
    <div class="kau-options">
      <label class="kau-option"><input type="radio" name="trauma_yesno" value="Yes"><span class="kau-option__label">Yes</span></label>
      <label class="kau-option"><input type="radio" name="trauma_yesno" value="No"><span class="kau-option__label">No</span></label>
    </div>
  </div>
  <div class="kau-field hidden" id="kau_trauma_wrap">
    <label class="kau-label" for="kau_trauma_details">Describe the injury</label>
    <textarea id="kau_trauma_details" name="trauma_details" class="kau-textarea" maxlength="300" placeholder="e.g., Sports injury in 2020..."></textarea>
  </div>
  
  <div class="kau-field">
    <label class="kau-label">Any previous surgery (not just knee)?</label>
    <div class="kau-options">
      <label class="kau-option"><input type="radio" name="past_surgery_any" value="Yes"><span class="kau-option__label">Yes</span></label>
      <label class="kau-option"><input type="radio" name="past_surgery_any" value="No"><span class="kau-option__label">No</span></label>
    </div>
  </div>
  
  <div class="kau-field">
    <label class="kau-label">Family history of bone/joint problems?</label>
    <div class="kau-options">
      <label class="kau-option"><input type="radio" name="fh_bone_joint" value="Yes"><span class="kau-option__label">Yes</span></label>
      <label class="kau-option"><input type="radio" name="fh_bone_joint" value="No"><span class="kau-option__label">No</span></label>
      <label class="kau-option"><input type="radio" name="fh_bone_joint" value="Unknown"><span class="kau-option__label">Unknown</span></label>
    </div>
  </div>
  <div class="kau-field">
    <label class="kau-label">Childhood knee issues in family?</label>
    <div class="kau-options">
      <label class="kau-option"><input type="radio" name="fh_childhood_knee" value="Yes"><span class="kau-option__label">Yes</span></label>
      <label class="kau-option"><input type="radio" name="fh_childhood_knee" value="No"><span class="kau-option__label">No</span></label>
      <label class="kau-option"><input type="radio" name="fh_childhood_knee" value="Unknown"><span class="kau-option__label">Unknown</span></label>
    </div>
  </div>
  <div class="kau-field hidden" id="kau_fh_details_wrap">
    <label class="kau-label" for="kau_fh_details">Family history details</label>
    <textarea id="kau_fh_details" name="fh_details" class="kau-textarea" maxlength="300" placeholder="e.g., Mother has osteoarthritis..."></textarea>
  </div>
</div>

<!-- STEP 5: Meds/Allergies -->
<div class="kau-section" data-step="5">
  <h2 class="kau-section__title">Medications & Allergies</h2>
  <p class="kau-section__desc">Current medications and any allergies.</p>
  
  <div class="kau-field">
    <label class="kau-label" for="kau_allergies">Any allergies?</label>
    <input type="text" id="kau_allergies" name="allergies" class="kau-input" maxlength="200" placeholder="e.g., Penicillin, ibuprofen...">
  </div>
  <div class="kau-field">
    <label class="kau-label" for="kau_meds_list">Current medications</label>
    <textarea id="kau_meds_list" name="meds_list" class="kau-textarea" maxlength="500" placeholder="List any medications..."></textarea>
  </div>
  <div class="kau-field">
    <label class="kau-label">Taking any of these?</label>
    <div class="kau-checkbox-grid">
      <label class="kau-checkbox"><input type="checkbox" name="meds_flags" value="Blood thinners"><span>Blood thinners</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="meds_flags" value="Steroids"><span>Steroids</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="meds_flags" value="Immunosuppressants"><span>Immunosuppressants</span></label>
      <label class="kau-checkbox"><input type="checkbox" name="meds_flags" value="None"><span>None</span></label>
    </div>
  </div>
</div>

<!-- STEP 6: Lifestyle -->
<div class="kau-section" data-step="6">
  <h2 class="kau-section__title">Lifestyle</h2>
  <p class="kau-section__desc">A few questions about your lifestyle.</p>
  
  <div class="kau-field">
    <label class="kau-label">Do you smoke?</label>
    <div class="kau-options">
      <label class="kau-option"><input type="radio" name="smoker" value="Never"><span class="kau-option__label">Never</span></label>
      <label class="kau-option"><input type="radio" name="smoker" value="Former"><span class="kau-option__label">Former</span></label>
      <label class="kau-option"><input type="radio" name="smoker" value="Current"><span class="kau-option__label">Current</span></label>
    </div>
  </div>
  <div class="kau-field">
    <label class="kau-label">Do you drink alcohol?</label>
    <div class="kau-options">
      <label class="kau-option"><input type="radio" name="alcohol_yesno" value="Yes"><span class="kau-option__label">Yes</span></label>
      <label class="kau-option"><input type="radio" name="alcohol_yesno" value="No"><span class="kau-option__label">No</span></label>
    </div>
  </div>
  <div class="kau-field hidden" id="kau_alcohol_wrap">
    <label class="kau-label" for="kau_alcohol_units">Units per week?</label>
    <select id="kau_alcohol_units" name="alcohol_units" class="kau-select"><option value="">Select...</option><option value="1-7">1-7</option><option value="8-14">8-14</option><option value="15-21">15-21</option><option value="22+">22+</option></select>
    <p class="kau-hint">1 unit = 1 small glass of wine or half a pint</p>
  </div>
  <div class="kau-field">
    <label class="kau-label" for="kau_other_info">Anything else we should know?</label>
    <textarea id="kau_other_info" name="other_info" class="kau-textarea" maxlength="500" placeholder="Any other relevant information..."></textarea>
  </div>
</div>

<!-- STEP 7: Expectations -->
<div class="kau-section" data-step="7">
  <h2 class="kau-section__title">Your Goals</h2>
  <p class="kau-section__desc">What are you hoping to achieve?</p>
  
  <div class="kau-field">
    <label class="kau-label" for="kau_expectations">Your knee health goals</label>
    <textarea id="kau_expectations" name="expectations" class="kau-textarea" maxlength="500" placeholder="e.g., Return to running, reduce daily pain..."></textarea>
  </div>
  <div class="kau-field">
    <label class="kau-label" for="kau_ref_source">How did you hear about us?</label>
    <select id="kau_ref_source" name="ref_source" class="kau-select"><option value="">Select...</option><option value="Google">Google</option><option value="Social media">Social media</option><option value="Friend/family">Friend/family</option><option value="Healthcare provider">Healthcare provider</option><option value="Advertisement">Advertisement</option><option value="Other">Other</option></select>
  </div>
  <input type="hidden" id="kau_utm_source" name="utm_source">
  <input type="hidden" id="kau_utm_medium" name="utm_medium">
  <input type="hidden" id="kau_utm_campaign" name="utm_campaign">
</div>

<!-- STEP 8: Review -->
<div class="kau-section" data-step="8">
  <h2 class="kau-section__title">Review Your Answers</h2>
  <p class="kau-section__desc">Please check your responses before submitting.</p>
  
  <div class="kau-score-preview band-optimal" id="kauScorePreview-{{ section_id }}">
    <p class="kau-score-preview__label">Preview Score</p>
    <div class="kau-score-preview__value" id="kauScoreValue-{{ section_id }}">0</div>
    <span class="kau-score-preview__band" id="kauScoreBand-{{ section_id }}">--</span>
    <p class="kau-score-preview__note">This is a preview. Your actual score will be calculated after submission.</p>
  </div>
  
  <div class="kau-review" id="kauReview-{{ section_id }}">
    <h3 class="kau-review__title">Summary</h3>
    <!-- Populated by JS -->
  </div>
</div>

<!-- STEP 9: Submit -->
<div class="kau-section" data-step="9">
  <h2 class="kau-section__title">Submit Your Assessment</h2>
  <p class="kau-section__desc">Please confirm your consent to proceed.</p>
  
  <div class="kau-consent required">
    <div class="kau-consent__header"><span class="kau-consent__title">Clinical Processing Consent</span><span class="kau-consent__badge required">Required</span></div>
    <label><input type="checkbox" id="kau_consent_clinical" name="consent_clinical" value="Yes" required><p>I consent to my health information being processed to provide personalised knee health recommendations. I understand this is not medical advice.</p></label>
  </div>
  
  <div class="kau-consent">
    <div class="kau-consent__header"><span class="kau-consent__title">Marketing Communications</span><span class="kau-consent__badge optional">Optional</span></div>
    <label><input type="checkbox" id="kau_consent_marketing" name="consent_marketing" value="Yes"><p>I would like to receive occasional emails about joint health tips and offers.</p></label>
  </div>
  
  <button type="submit" class="kau-btn kau-btn--primary kau-btn--submit" id="kauSubmit-{{ section_id }}">Submit Assessment</button>
  
  <div class="kau-urgent">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    <p><strong>Important:</strong> If your knee is acutely swollen, hot, or you cannot weight-bear, seek urgent care immediately.</p>
  </div>
</div>

</form>

<!-- Navigation -->
<div class="kau-nav" id="kauNav-{{ section_id }}">
  <button type="button" class="kau-btn kau-btn--secondary" id="kauPrev-{{ section_id }}" style="display:none">Back</button>
  <button type="button" class="kau-btn kau-btn--primary" id="kauNext-{{ section_id }}">Continue</button>
</div>

<!-- Loading -->
<div class="kau-loading" id="kauLoading-{{ section_id }}">
  <div class="kau-spinner"></div>
  <p>Preparing your submission...</p>
</div>

</div>
</section>

<script>
(function() {
  'use strict';
  const S = '{{ section_id }}';
  const FORM_ID = '{{ form_id }}';
  const REDIRECT = '{{ redirect_url }}';
  let prefillMap = {};
  try { prefillMap = JSON.parse('{{ prefill_map | escape }}'); } catch(e) { prefillMap = {}; }
  
  const TOTAL_STEPS = 9;
  let currentStep = 1;
  
  const $ = id => document.getElementById(id);
  const $$ = sel => document.querySelectorAll(sel);
  
  const form = $('kauForm-'+S);
  const sections = form.querySelectorAll('.kau-section');
  const progressBar = $('kauProgressBar-'+S);
  const stepLabels = $('kauStepLabels-'+S).querySelectorAll('.kau-progress__step');
  const pctText = $('kauPct-'+S);
  const prevBtn = $('kauPrev-'+S);
  const nextBtn = $('kauNext-'+S);
  const nav = $('kauNav-'+S);
  const loading = $('kauLoading-'+S);
  
  // UTM init
  const params = new URLSearchParams(location.search);
  $('kau_utm_source').value = params.get('utm_source') || '';
  $('kau_utm_medium').value = params.get('utm_medium') || '';
  $('kau_utm_campaign').value = params.get('utm_campaign') || '';
  
  // Analytics (non-PHI only)
  function trackEvent(name) {
    const data = { page_path: location.pathname, timestamp: new Date().toISOString(), utm_source: params.get('utm_source')||'', utm_medium: params.get('utm_medium')||'', utm_campaign: params.get('utm_campaign')||'' };
    if (typeof gtag === 'function') gtag('event', name, data);
    if (typeof dataLayer !== 'undefined') dataLayer.push({ event: name, ...data });
  }
  trackEvent('knee_assessment_view');
  
  function updateProgress() {
    const pct = Math.round((currentStep / TOTAL_STEPS) * 100);
    progressBar.style.width = pct + '%';
    pctText.textContent = pct;
    stepLabels.forEach((lbl, i) => {
      lbl.classList.remove('active', 'done');
      if (i + 1 < currentStep) lbl.classList.add('done');
      else if (i + 1 === currentStep) lbl.classList.add('active');
    });
    prevBtn.style.display = currentStep > 1 ? 'block' : 'none';
    nav.style.display = currentStep === TOTAL_STEPS ? 'none' : 'flex';
  }
  
  function showStep(n) {
    sections.forEach((s, i) => s.classList.toggle('active', i + 1 === n));
    currentStep = n;
    updateProgress();
    if (n === 8) buildReview();
    if (n === 8 || n === 9) updateScorePreview();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  
  function validate(n) {
    const section = sections[n - 1];
    const required = section.querySelectorAll('[required]');
    let valid = true;
    required.forEach(inp => {
      inp.classList.remove('error');
      const err = inp.parentNode.querySelector('.kau-error-msg');
      if (err) err.remove();
      let ok = true;
      if (inp.type === 'radio') {
        ok = !!section.querySelector('input[name="'+inp.name+'"]:checked');
      } else if (inp.type === 'checkbox') {
        ok = inp.checked;
      } else {
        ok = inp.value.trim() !== '';
        if (inp.type === 'email' && inp.value && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(inp.value)) ok = false;
      }
      if (!ok) {
        valid = false;
        inp.classList.add('error');
        const e = document.createElement('p');
        e.className = 'kau-error-msg';
        e.textContent = inp.type === 'email' && inp.value ? 'Invalid email' : 'Required';
        inp.parentNode.appendChild(e);
      }
    });
    return valid;
  }
  
  // Slider updates
  $$('.kau-slider').forEach(sl => {
    const val = $(sl.id + '_val');
    if (val) {
      sl.addEventListener('input', () => val.textContent = sl.value);
    }
  });
  
  // Checkbox styling
  $$('.kau-checkbox input').forEach(cb => {
    cb.addEventListener('change', () => cb.closest('.kau-checkbox').classList.toggle('checked', cb.checked));
  });
  
  // Conditional fields
  function setupConditionals() {
    $$('input[name="prior_problem"]').forEach(r => r.addEventListener('change', () => $('kau_prior_desc_wrap').classList.toggle('hidden', r.value !== 'Yes' || !r.checked)));
    $$('input[name="treatments"]').forEach(cb => cb.addEventListener('change', () => {
      const vals = Array.from($$('input[name="treatments"]:checked')).map(c => c.value);
      $('kau_injection_wrap').classList.toggle('hidden', !vals.includes('Injections'));
      $('kau_surgery_wrap').classList.toggle('hidden', !vals.includes('Surgery'));
    }));
    $$('input[name="treat_helped"]').forEach(r => r.addEventListener('change', () => $('kau_treat_duration_wrap').classList.toggle('hidden', r.value !== 'Yes' || !r.checked)));
    $$('input[name="pmh"]').forEach(cb => cb.addEventListener('change', () => {
      const vals = Array.from($$('input[name="pmh"]:checked')).map(c => c.value);
      $('kau_pmh_other_wrap').classList.toggle('hidden', !vals.includes('Other'));
    }));
    $$('input[name="trauma_yesno"]').forEach(r => r.addEventListener('change', () => $('kau_trauma_wrap').classList.toggle('hidden', r.value !== 'Yes' || !r.checked)));
    function updateFH() {
      const a = document.querySelector('input[name="fh_bone_joint"]:checked');
      const b = document.querySelector('input[name="fh_childhood_knee"]:checked');
      $('kau_fh_details_wrap').classList.toggle('hidden', !((a && a.value==='Yes')||(b && b.value==='Yes')));
    }
    $$('input[name="fh_bone_joint"],input[name="fh_childhood_knee"]').forEach(r => r.addEventListener('change', updateFH));
    $$('input[name="alcohol_yesno"]').forEach(r => r.addEventListener('change', () => $('kau_alcohol_wrap').classList.toggle('hidden', r.value !== 'Yes' || !r.checked)));
  }
  setupConditionals();
  
  // Score calculation (max 50)
  function calcScore() {
    const pain = parseInt($('kau_pain').value) || 0;
    const sleep = parseInt($('kau_sleep').value) || 0;
    const swelling = parseInt($('kau_swelling').value) || 0;
    const instability = parseInt($('kau_instability').value) || 0;
    const stiffness = parseInt($('kau_stiffness').value) || 0;
    const stairs = parseInt($('kau_stairs').value) || 0;
    const func = parseInt($('kau_function').value) || 0;
    return pain + sleep + swelling + instability + stiffness + stairs + func;
  }
  
  function getBand(total) {
    if (total < 25) return { band: 'Optimal', cls: 'band-optimal' };
    if (total < 50) return { band: 'Good', cls: 'band-green' };
    if (total < 75) return { band: 'Fair', cls: 'band-amber' };
    return { band: 'Pay Attention', cls: 'band-red' };
  }
  
  function updateScorePreview() {
    const total = calcScore();
    const { band, cls } = getBand(total);
    const preview = $('kauScorePreview-'+S);
    preview.className = 'kau-score-preview ' + cls;
    $('kauScoreValue-'+S).textContent = total;
    $('kauScoreBand-'+S).textContent = band;
  }
  
  // Build review summary
  function buildReview() {
    const data = collectData();
    const review = $('kauReview-'+S);
    let html = '<h3 class="kau-review__title">Summary</h3>';
    html += '<div class="kau-review__group"><div class="kau-review__group-title">Personal</div>';
    html += '<div class="kau-review__item"><span class="kau-review__item-label">Name</span><span class="kau-review__item-value">'+esc(data.first_name)+' '+esc(data.last_name)+'</span></div>';
    html += '<div class="kau-review__item"><span class="kau-review__item-label">Email</span><span class="kau-review__item-value">'+esc(data.email)+'</span></div>';
    html += '</div>';
    html += '<div class="kau-review__group"><div class="kau-review__group-title">Symptoms</div>';
    ['pain','sleep','swelling','instability','stiffness','stairs','function'].forEach(k => {
      html += '<div class="kau-review__item"><span class="kau-review__item-label">'+k.charAt(0).toUpperCase()+k.slice(1)+'</span><span class="kau-review__item-value">'+esc(data[k])+'</span></div>';
    });
    html += '</div>';
    review.innerHTML = html;
  }
  
  function esc(s) { return String(s||'').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  
  // Collect form data
  function collectData() {
    const fd = new FormData(form);
    const data = {};
    for (const [k, v] of fd.entries()) {
      if (data[k]) {
        if (!Array.isArray(data[k])) data[k] = [data[k]];
        data[k].push(v);
      } else data[k] = v;
    }
    return data;
  }
  
  // Build Jotform URL
  function buildJotformUrl(data) {
    const base = 'https://form.jotform.com/' + FORM_ID;
    const p = new URLSearchParams();
    for (const [key, val] of Object.entries(data)) {
      const qid = prefillMap[key] || key;
      if (val) {
        if (Array.isArray(val)) val.forEach(v => p.append(qid+'[]', v));
        else p.append(qid, val);
      }
    }
    return base + '?' + p.toString();
  }
  
  // Navigation
  nextBtn.addEventListener('click', () => {
    if (validate(currentStep) && currentStep < TOTAL_STEPS) {
      if (currentStep === 1) trackEvent('knee_assessment_start');
      showStep(currentStep + 1);
    }
  });
  prevBtn.addEventListener('click', () => { if (currentStep > 1) showStep(currentStep - 1); });
  
  // Submit
  form.addEventListener('submit', e => {
    e.preventDefault();
    if (!validate(TOTAL_STEPS)) return;
    trackEvent('knee_assessment_submit_click');
    form.style.display = 'none';
    nav.style.display = 'none';
    loading.classList.add('active');
    const data = collectData();
    const url = buildJotformUrl(data);
    setTimeout(() => { window.location.href = url; }, 500);
  });
  
  updateProgress();
})();
</script>

{% schema %}
{
  "name": "Full Knee Assessment",
  "tag": "section",
  "class": "knee-assessment-ui-section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Full Knee Assessment" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Clinician-designed by <strong>Sportshealing</strong>. Powered by <strong>OmKneeHealth</strong>." },
