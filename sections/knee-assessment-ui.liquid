    { "type": "url", "id": "redirect_url", "label": "Post-Submit Redirect", "default": "/pages/next-steps-knee" },
    { "type": "url", "id": "booking_link", "label": "Booking Link (optional)" },
    { "type": "header", "content": "Compliance Links" },
    { "type": "url", "id": "privacy_link", "label": "Privacy Policy URL", "default": "/policies/privacy-policy" },
    { "type": "url", "id": "deletion_link", "label": "Data Deletion Request URL", "default": "/pages/data-deletion-request" },
    { "type": "header", "content": "SEO" },
    { "type": "text", "id": "seo_title", "label": "SEO Title", "default": "Full Knee Assessment | OmKneeHealth" },
    { "type": "textarea", "id": "seo_description", "label": "Meta Description", "default": "Complete our clinician-designed full knee assessment in 4–6 minutes to help guide next steps. UK GDPR-aligned and secure." },
    { "type": "text", "id": "og_title", "label": "OG Title", "default": "Full Knee Assessment" },
    { "type": "textarea", "id": "og_description", "label": "OG Description", "default": "A secure, clinician-designed full knee assessment to guide your next steps." },
    { "type": "header", "content": "Branding" },
    { "type": "color", "id": "primary_color", "label": "Primary Color", "default": "#166534" },
    { "type": "color", "id": "primary_light", "label": "Primary Light", "default": "#dcfce7" },
    { "type": "color", "id": "secondary_color", "label": "Secondary Color", "default": "#0369a1" }
  ],
  "presets": [{ "name": "Knee Assessment UI", "category": "Custom" }]
}
{% endschema %}
