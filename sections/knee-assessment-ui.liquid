{% comment %}
  Knee Assessment UI - Quiz-Style Section
  ========================================
  Collects knee health data in-browser only (no PHI storage on Shopify).
  Submits directly to Jotform via prefilled URL or API POST.
  
  Setup:
  1. Add to sections/knee-assessment-ui.liquid
  2. Create page template with this section
  3. Configure Jotform Form ID and field mappings in Theme Editor
{% endcomment %}

{%- liquid
  assign section_id = section.id | default: 'kau'
  assign form_id = section.settings.jotform_form_id | default: 'PLACEHOLDER_FORM_ID'
-%}

<style>
  /* ===== SCOPED STYLES ===== */
  #kau-{{ section_id }} {
    --kau-primary: {{ section.settings.primary_color | default: '#166534' }};
    --kau-primary-light: {{ section.settings.primary_light | default: '#dcfce7' }};
    --kau-danger: #dc2626;
    --kau-danger-light: #fef2f2;
    --kau-amber: #d97706;
    --kau-amber-light: #fffbeb;
    --kau-green: #16a34a;
    --kau-green-light: #f0fdf4;
    --kau-optimal: #0284c7;
    --kau-optimal-light: #e0f2fe;
    --kau-text: #1a1a1a;
    --kau-text-muted: #64748b;
    --kau-bg: #ffffff;
    --kau-bg-alt: #f8fafc;
    --kau-border: #e2e8f0;
    --kau-radius: 12px;
    --kau-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: var(--kau-text);
    background: var(--kau-bg);
  }

  #kau-{{ section_id }} * { box-sizing: border-box; }

  .kau-container {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 20px 60px;
  }

  /* Hero */
  .kau-hero {
    text-align: center;
    margin-bottom: 32px;
  }

  .kau-hero__title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    margin: 0 0 8px;
    color: var(--kau-text);
  }

  .kau-hero__subtitle {
    font-size: 1rem;
    color: var(--kau-text-muted);
    margin: 0;
  }

  /* Progress */
  .kau-progress {
    margin-bottom: 32px;
  }

  .kau-progress__bar {
    height: 8px;
    background: var(--kau-border);
    border-radius: 4px;
    overflow: hidden;
  }

  .kau-progress__fill {
    height: 100%;
    background: var(--kau-primary);
    transition: width 0.3s ease;
    border-radius: 4px;
  }

  .kau-progress__text {
    font-size: 0.875rem;
    color: var(--kau-text-muted);
    margin-top: 8px;
    text-align: center;
  }

  /* Sections */
  .kau-section {
    display: none;
    animation: kauFadeIn 0.3s ease;
  }

  .kau-section.active { display: block; }

  @keyframes kauFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .kau-section__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--kau-text);
  }

  .kau-section__desc {
    font-size: 0.9375rem;
    color: var(--kau-text-muted);
    margin: 0 0 24px;
  }

  /* Form Elements */
  .kau-field {
    margin-bottom: 20px;
  }

  .kau-field.hidden { display: none; }

  .kau-label {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--kau-text);
    margin-bottom: 8px;
  }

  .kau-label--required::after {
    content: ' *';
    color: var(--kau-danger);
  }

  .kau-input {
    width: 100%;
    padding: 12px 16px;
    font-size: 1rem;
    border: 1px solid var(--kau-border);
    border-radius: var(--kau-radius);
    background: var(--kau-bg);
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .kau-input:focus {
    outline: none;
    border-color: var(--kau-primary);
    box-shadow: 0 0 0 3px var(--kau-primary-light);
  }

  .kau-input.error {
    border-color: var(--kau-danger);
  }

  .kau-error-msg {
    font-size: 0.8125rem;
    color: var(--kau-danger);
    margin-top: 4px;
  }

  /* Slider */
  .kau-slider-wrap {
    padding: 8px 0;
  }

  .kau-slider {
    -webkit-appearance: none;
    width: 100%;
    height: 8px;
    background: var(--kau-border);
    border-radius: 4px;
    outline: none;
  }

  .kau-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 24px;
    height: 24px;
    background: var(--kau-primary);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: var(--kau-shadow);
  }

  .kau-slider::-moz-range-thumb {
    width: 24px;
    height: 24px;
    background: var(--kau-primary);
    border-radius: 50%;
    cursor: pointer;
    border: none;
  }

  .kau-slider-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--kau-text-muted);
    margin-top: 4px;
  }

  .kau-slider-value {
    text-align: center;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--kau-primary);
    margin-top: 8px;
  }

  /* Radio/Checkbox Groups */
  .kau-options {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .kau-option {
    position: relative;
  }

  .kau-option input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .kau-option__label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: var(--kau-bg-alt);
    border: 2px solid var(--kau-border);
    border-radius: var(--kau-radius);
    font-size: 0.9375rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .kau-option input:checked + .kau-option__label {
    background: var(--kau-primary-light);
    border-color: var(--kau-primary);
    color: var(--kau-primary);
  }

  .kau-option input:focus + .kau-option__label {
    box-shadow: 0 0 0 3px var(--kau-primary-light);
  }

  /* Checkbox Grid */
  .kau-checkbox-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 10px;
  }

  .kau-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px;
    background: var(--kau-bg-alt);
    border: 1px solid var(--kau-border);
    border-radius: var(--kau-radius);
    cursor: pointer;
    transition: all 0.2s;
  }

  .kau-checkbox:hover {
    border-color: var(--kau-primary);
  }

  .kau-checkbox input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--kau-primary);
    flex-shrink: 0;
  }

  .kau-checkbox span {
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* Textarea */
  .kau-textarea {
    width: 100%;
    min-height: 100px;
    padding: 12px 16px;
    font-size: 1rem;
    border: 1px solid var(--kau-border);
    border-radius: var(--kau-radius);
    resize: vertical;
    font-family: inherit;
  }

  .kau-textarea:focus {
    outline: none;
    border-color: var(--kau-primary);
    box-shadow: 0 0 0 3px var(--kau-primary-light);
  }

  /* Score Preview */
  .kau-score-preview {
    background: var(--kau-bg-alt);
    border: 2px solid var(--kau-border);
    border-radius: var(--kau-radius);
    padding: 24px;
    margin-bottom: 24px;
    text-align: center;
  }

  .kau-score-preview__title {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--kau-text-muted);
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .kau-score-preview__value {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 8px;
  }

  .kau-score-preview__band {
    display: inline-block;
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .kau-score-preview.band-red {
    border-color: var(--kau-danger);
  }
  .kau-score-preview.band-red .kau-score-preview__value { color: var(--kau-danger); }
  .kau-score-preview.band-red .kau-score-preview__band { background: var(--kau-danger-light); color: var(--kau-danger); }

  .kau-score-preview.band-amber {
    border-color: var(--kau-amber);
  }
  .kau-score-preview.band-amber .kau-score-preview__value { color: var(--kau-amber); }
  .kau-score-preview.band-amber .kau-score-preview__band { background: var(--kau-amber-light); color: var(--kau-amber); }

  .kau-score-preview.band-green {
    border-color: var(--kau-green);
  }
  .kau-score-preview.band-green .kau-score-preview__value { color: var(--kau-green); }
  .kau-score-preview.band-green .kau-score-preview__band { background: var(--kau-green-light); color: var(--kau-green); }

  .kau-score-preview.band-optimal {
    border-color: var(--kau-optimal);
  }
  .kau-score-preview.band-optimal .kau-score-preview__value { color: var(--kau-optimal); }
  .kau-score-preview.band-optimal .kau-score-preview__band { background: var(--kau-optimal-light); color: var(--kau-optimal); }

  /* Navigation Buttons */
  .kau-nav {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 32px;
  }

  .kau-btn {
    padding: 14px 28px;
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--kau-radius);
    cursor: pointer;
    transition: all 0.2s;
    border: none;
  }

  .kau-btn--secondary {
    background: var(--kau-bg-alt);
    color: var(--kau-text);
    border: 1px solid var(--kau-border);
  }

  .kau-btn--secondary:hover {
    background: var(--kau-border);
  }

  .kau-btn--primary {
    background: var(--kau-primary);
    color: #fff;
    flex: 1;
    max-width: 200px;
    margin-left: auto;
  }

  .kau-btn--primary:hover {
    opacity: 0.9;
  }

  .kau-btn--primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .kau-btn--submit {
    width: 100%;
    max-width: none;
    padding: 16px 32px;
    font-size: 1.125rem;
  }

  /* Consent */
  .kau-consent {
    background: var(--kau-bg-alt);
    border: 1px solid var(--kau-border);
    border-radius: var(--kau-radius);
    padding: 16px;
    margin-bottom: 16px;
  }

  .kau-consent__title {
    font-weight: 600;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .kau-consent__title.required::after {
    content: 'Required';
    font-size: 0.75rem;
    background: var(--kau-danger-light);
    color: var(--kau-danger);
    padding: 2px 8px;
    border-radius: 4px;
  }

  .kau-consent__title.optional::after {
    content: 'Optional';
    font-size: 0.75rem;
    background: var(--kau-bg-alt);
    color: var(--kau-text-muted);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid var(--kau-border);
  }

  .kau-consent label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }

  .kau-consent input {
    width: 20px;
    height: 20px;
    margin-top: 2px;
    accent-color: var(--kau-primary);
    flex-shrink: 0;
  }

  .kau-consent p {
    font-size: 0.875rem;
    color: var(--kau-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  /* Inline Fields */
  .kau-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media (max-width: 480px) {
    .kau-row { grid-template-columns: 1fr; }
  }

  /* Privacy Notice */
  .kau-privacy {
    font-size: 0.8125rem;
    color: var(--kau-text-muted);
    text-align: center;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--kau-border);
  }

  .kau-privacy a {
    color: var(--kau-primary);
    text-decoration: underline;
  }

  /* Loading State */
  .kau-loading {
    display: none;
    text-align: center;
    padding: 40px;
  }

  .kau-loading.active { display: block; }

  .kau-spinner {
    width: 48px;
    height: 48px;
    border: 4px solid var(--kau-border);
    border-top-color: var(--kau-primary);
    border-radius: 50%;
    animation: kauSpin 0.8s linear infinite;
    margin: 0 auto 16px;
  }

  @keyframes kauSpin {
    to { transform: rotate(360deg); }
  }

  /* Field Info */
  .kau-hint {
    font-size: 0.8125rem;
    color: var(--kau-text-muted);
    margin-top: 4px;
  }
</style>

<section id="kau-{{ section_id }}" class="kau-section-wrap" aria-label="Knee Assessment Questionnaire">
  <div class="kau-container">
    
    <!-- Hero -->
    <header class="kau-hero">
      <h1 class="kau-hero__title">{{ section.settings.heading | default: 'Knee Health Assessment' }}</h1>
      <p class="kau-hero__subtitle">{{ section.settings.subheading | default: 'Complete this questionnaire to receive personalised recommendations.' }}</p>
    </header>

    <!-- Progress Bar -->
    <div class="kau-progress">
      <div class="kau-progress__bar">
        <div class="kau-progress__fill" id="kauProgress-{{ section_id }}" style="width: 0%"></div>
      </div>
      <p class="kau-progress__text"><span id="kauStep-{{ section_id }}">1</span> of <span id="kauTotalSteps-{{ section_id }}">6</span></p>
    </div>

    <form id="kauForm-{{ section_id }}" novalidate>
      
      <!-- ===== SECTION 1: Personal Details ===== -->
      <div class="kau-section active" data-section="1">
        <h2 class="kau-section__title">Your Details</h2>
        <p class="kau-section__desc">We need some basic information to personalise your assessment.</p>

        <div class="kau-row">
          <div class="kau-field">
            <label class="kau-label kau-label--required" for="kau_first_name">First Name</label>
            <input type="text" id="kau_first_name" name="first_name" class="kau-input" required maxlength="50" autocomplete="given-name">
          </div>
          <div class="kau-field">
            <label class="kau-label kau-label--required" for="kau_last_name">Last Name</label>
            <input type="text" id="kau_last_name" name="last_name" class="kau-input" required maxlength="50" autocomplete="family-name">
          </div>
        </div>

        <div class="kau-field">
          <label class="kau-label kau-label--required" for="kau_dob">Date of Birth</label>
          <input type="date" id="kau_dob" name="dob" class="kau-input" required>
        </div>

        <div class="kau-field">
          <label class="kau-label kau-label--required" for="kau_email">Email Address</label>
          <input type="email" id="kau_email" name="email" class="kau-input" required maxlength="100" autocomplete="email">
        </div>

        <div class="kau-row">
          <div class="kau-field">
            <label class="kau-label" for="kau_mobile">Mobile Number</label>
            <input type="tel" id="kau_mobile" name="mobile" class="kau-input" maxlength="20" autocomplete="tel">
          </div>
          <div class="kau-field">
            <label class="kau-label" for="kau_postcode">Postcode</label>
            <input type="text" id="kau_postcode" name="postcode" class="kau-input" maxlength="10" autocomplete="postal-code">
          </div>
        </div>
      </div>

      <!-- ===== SECTION 2: Knee Symptom Domains (Scoring) ===== -->
      <div class="kau-section" data-section="2">
        <h2 class="kau-section__title">Your Knee Symptoms</h2>
        <p class="kau-section__desc">Rate each symptom based on your experience over the past 7 days.</p>

        <!-- Pain (0-10) -->
        <div class="kau-field">
          <label class="kau-label kau-label--required">Knee Pain Level</label>
          <div class="kau-slider-wrap">
            <input type="range" id="kau_pain" name="pain" class="kau-slider" min="0" max="10" value="0" data-domain="pain">
            <div class="kau-slider-labels">
              <span>0 - No pain</span>
              <span>10 - Severe pain</span>
            </div>
            <div class="kau-slider-value" id="kau_pain_val">0</div>
          </div>
        </div>

        <!-- Sleep Disturbance (0-10) -->
        <div class="kau-field">
          <label class="kau-label kau-label--required">Sleep Disturbance from Knee</label>
          <div class="kau-slider-wrap">
            <input type="range" id="kau_sleep" name="sleep" class="kau-slider" min="0" max="10" value="0" data-domain="sleep">
            <div class="kau-slider-labels">
              <span>0 - No disturbance</span>
              <span>10 - Severe disturbance</span>
            </div>
            <div class="kau-slider-value" id="kau_sleep_val">0</div>
          </div>
        </div>

        <!-- Swelling (0-5) -->
        <div class="kau-field">
          <label class="kau-label kau-label--required">Swelling</label>
          <div class="kau-slider-wrap">
            <input type="range" id="kau_swelling" name="swelling" class="kau-slider" min="0" max="5" value="0" data-domain="swelling">
            <div class="kau-slider-labels">
              <span>0 - None</span>
              <span>5 - Severe</span>
            </div>
            <div class="kau-slider-value" id="kau_swelling_val">0</div>
          </div>
        </div>

        <!-- Instability (0-5) -->
        <div class="kau-field">
          <label class="kau-label kau-label--required">Instability / Giving Way</label>
          <div class="kau-slider-wrap">
            <input type="range" id="kau_instability" name="instability" class="kau-slider" min="0" max="5" value="0" data-domain="instability">
            <div class="kau-slider-labels">
              <span>0 - Stable</span>
              <span>5 - Very unstable</span>
            </div>
            <div class="kau-slider-value" id="kau_instability_val">0</div>
          </div>
        </div>

        <!-- Stiffness (0-5) -->
        <div class="kau-field">
          <label class="kau-label kau-label--required">Stiffness / Restriction</label>
          <div class="kau-slider-wrap">
            <input type="range" id="kau_stiffness" name="stiffness" class="kau-slider" min="0" max="5" value="0" data-domain="stiffness">
            <div class="kau-slider-labels">
              <span>0 - No stiffness</span>
              <span>5 - Very stiff</span>
            </div>
            <div class="kau-slider-value" id="kau_stiffness_val">0</div>
          </div>
        </div>

        <!-- Stairs (0-5) -->
        <div class="kau-field">
          <label class="kau-label kau-label--required">Difficulty with Stairs</label>
          <div class="kau-slider-wrap">
            <input type="range" id="kau_stairs" name="stairs" class="kau-slider" min="0" max="5" value="0" data-domain="stairs">
            <div class="kau-slider-labels">
              <span>0 - No difficulty</span>
              <span>5 - Unable</span>
            </div>
            <div class="kau-slider-value" id="kau_stairs_val">0</div>
          </div>
        </div>

        <!-- Function (0-10) -->
        <div class="kau-field">
          <label class="kau-label kau-label--required">Overall Function / Mobility</label>
          <div class="kau-slider-wrap">
            <input type="range" id="kau_function" name="function" class="kau-slider" min="0" max="10" value="0" data-domain="function">
            <div class="kau-slider-labels">
              <span>0 - Normal</span>
              <span>10 - Severely limited</span>
            </div>
            <div class="kau-slider-value" id="kau_function_val">0</div>
          </div>
        </div>

        <!-- Live Score Preview -->
        <div class="kau-score-preview band-optimal" id="kauScorePreview-{{ section_id }}">
          <p class="kau-score-preview__title">Your Knee Score (Preview)</p>
          <div class="kau-score-preview__value" id="kauScoreValue-{{ section_id }}">100</div>
          <span class="kau-score-preview__band" id="kauScoreBand-{{ section_id }}">Optimal</span>
          <p class="kau-hint" style="margin-top: 12px;">Higher score = better knee health. Final score calculated on submission.</p>
        </div>
      </div>

      <!-- ===== SECTION 3: Prior Problems & Treatments ===== -->
      <div class="kau-section" data-section="3">
        <h2 class="kau-section__title">Previous Knee Problems</h2>
        <p class="kau-section__desc">Tell us about any previous issues with your knee.</p>

        <!-- Prior Problem -->
        <div class="kau-field">
          <label class="kau-label kau-label--required">Have you had a previous knee problem?</label>
          <div class="kau-options">
            <label class="kau-option">
              <input type="radio" name="prior_problem" value="Yes" required>
              <span class="kau-option__label">Yes</span>
            </label>
            <label class="kau-option">
              <input type="radio" name="prior_problem" value="No">
              <span class="kau-option__label">No</span>
            </label>
          </div>
        </div>

        <!-- Prior Description (conditional) -->
        <div class="kau-field hidden" id="kau_prior_desc_wrap">
          <label class="kau-label" for="kau_prior_description">Please describe the problem</label>
          <textarea id="kau_prior_description" name="prior_description" class="kau-textarea" maxlength="500" placeholder="e.g., ACL tear in 2018, osteoarthritis diagnosis..."></textarea>
        </div>

        <!-- Treatments -->
        <div class="kau-field">
          <label class="kau-label">What treatments have you tried? (Select all that apply)</label>
          <div class="kau-checkbox-grid">
            <label class="kau-checkbox">
              <input type="checkbox" name="treatments" value="Physiotherapy">
              <span>Physiotherapy</span>
            </label>
            <label class="kau-checkbox">
              <input type="checkbox" name="treatments" value="Medication">
              <span>Medication</span>
            </label>
            <label class="kau-checkbox">
              <input type="checkbox" name="treatments" value="Injections">
