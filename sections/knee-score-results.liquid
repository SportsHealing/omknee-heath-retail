{% comment %}
  OmKneeHealth Knee Score Results Section
  
  RECOMMENDED PLACEMENTS:
  ========================
  
  1. PRODUCT PAGE (Joint Supplement):
     - Position: Below "How to take" section, above "FAQs"
     - In theme editor: Add this section after product-how-to-use, before product-faq
  
  2. DEDICATED LANDING PAGE:
     - Position: Below the score calculator, above testimonials
     - Create a new page template with sections in this order:
       a. Hero section
       b. knee-sleep-score (calculator)
       c. knee-score-results (this section)
       d. Testimonials
       e. CTA section
  
  3. HOMEPAGE:
     - Position: After the main value proposition, before product showcase
  
  ANCHOR NAVIGATION:
  ==================
  This section includes anchor IDs that CTAs can link to:
  - #shop-supplements - Shop supplements section
  - #evidence-science - Evidence & Science section  
  - #book-imaging - Book imaging section
  - #knee-recommendations - Main recommendations panel
  
  Example CTA links:
  - href="#shop-supplements" - Scrolls to supplements
  - href="/pages/science#evidence-science" - Links to science page section
  - href="https://mykneescan.com" - External imaging booking
{% endcomment %}

{% schema %}
{
  "name": "Knee Score Results",
  "tag": "section",
  "class": "knee-score-results-section",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID (for anchor links)",
      "default": "knee-recommendations"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Your Personalised Recommendations"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "Based on your assessment score, here are tailored next steps for your knee health journey."
    },
    {
      "type": "header",
      "content": "Shop Supplements Section"
    },
    {
      "type": "text",
      "id": "shop_title",
      "label": "Shop Section Title",
      "default": "Shop Joint Support"
    },
    {
      "type": "collection",
      "id": "shop_collection",
      "label": "Product Collection"
    },
    {
      "type": "url",
      "id": "shop_url",
      "label": "Shop URL (fallback)",
      "default": "/collections/joint-optimisation"
    },
    {
      "type": "header",
      "content": "Evidence Section"
    },
    {
      "type": "text",
      "id": "evidence_title",
      "label": "Evidence Section Title",
      "default": "The Science Behind It"
    },
    {
      "type": "richtext",
      "id": "evidence_content",
      "label": "Evidence Content",
      "default": "<p>Our recommendations are based on peer-reviewed research and clinical guidelines. Each test package is designed to provide actionable insights for your specific situation.</p>"
    },
    {
      "type": "url",
      "id": "science_page_url",
      "label": "Science Page URL",
      "default": "/pages/science"
    },
    {
      "type": "header",
      "content": "Imaging Booking Section"
    },
    {
      "type": "text",
      "id": "imaging_title",
      "label": "Imaging Section Title",
      "default": "Book Your Scan"
    },
    {
      "type": "textarea",
      "id": "imaging_description",
      "label": "Imaging Description",
      "default": "Get detailed imaging of your knee to understand what's happening beneath the surface."
    },
    {
      "type": "url",
      "id": "imaging_url",
      "label": "Imaging Booking URL",
      "default": "https://mykneescan.com"
    },
    {
      "type": "url",
      "id": "clinician_url",
      "label": "Clinician Booking URL",
      "default": "https://sportshealing.com"
    },
    {
      "type": "header",
      "content": "Display Options"
    },
    {
      "type": "checkbox",
      "id": "show_shop_section",
      "label": "Show Shop Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_evidence_section",
      "label": "Show Evidence Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_imaging_section",
      "label": "Show Imaging Section",
      "default": true
    },
    {
      "type": "select",
      "id": "score_source",
      "label": "Primary Score Source",
      "options": [
        { "value": "index", "label": "Index Score (Knee + Sleep average)" },
        { "value": "knee", "label": "Pro Knee Score only" }
      ],
      "default": "index"
    }
  ],
  "presets": [
    {
      "name": "Knee Score Results",
      "category": "Health"
    }
  ]
}
{% endschema %}

<style>
  .knee-score-results-section {
    --ksr-bg: #faf9f7;
    --ksr-card-bg: #ffffff;
    --ksr-text: #1a1a1a;
    --ksr-text-muted: #6b7280;
    --ksr-border: #e5e5e5;
    --ksr-primary: #1e4d3a;
    --ksr-primary-hover: #163a2c;
    --ksr-accent: #2d5a47;
    
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: var(--ksr-bg);
    padding: 4rem 1rem;
    color: var(--ksr-text);
  }
  
  .ksr-container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .ksr-header {
    text-align: center;
    margin-bottom: 3rem;
  }
  
  .ksr-header h2 {
    font-size: 2rem;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--ksr-text);
  }
  
  .ksr-header p {
    color: var(--ksr-text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  /* Anchor sections */
  .ksr-anchor-section {
    scroll-margin-top: 100px;
    margin-bottom: 3rem;
  }
  
  .ksr-anchor-section:last-child {
    margin-bottom: 0;
  }
  
  /* Section cards */
  .ksr-section-card {
    background: var(--ksr-card-bg);
    border: 1px solid var(--ksr-border);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }
  
  .ksr-section-card h3 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 1rem;
    color: var(--ksr-text);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  
  .ksr-section-card h3 svg {
    color: var(--ksr-primary);
  }
  
  .ksr-section-card p {
    color: var(--ksr-text-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }
  
  /* Grid layouts */
  .ksr-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }
  
  .ksr-grid-3 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  
  /* Product cards */
  .ksr-product-card {
    background: var(--ksr-card-bg);
    border: 1px solid var(--ksr-border);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  
  .ksr-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0,0,0,0.08);
  }
  
  .ksr-product-card img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  
  .ksr-product-card-content {
    padding: 1rem;
  }
  
  .ksr-product-card h4 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--ksr-text);
  }
  
  .ksr-product-card .price {
    font-size: 1rem;
    font-weight: 600;
    color: var(--ksr-primary);
  }
  
  /* Buttons */
  .ksr-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
  }
  
  .ksr-btn-primary {
    background: var(--ksr-primary);
    color: white;
    border: none;
  }
  
  .ksr-btn-primary:hover {
    background: var(--ksr-primary-hover);
    transform: translateY(-1px);
  }
  
  .ksr-btn-secondary {
    background: transparent;
    color: var(--ksr-primary);
    border: 1px solid var(--ksr-primary);
  }
  
  .ksr-btn-secondary:hover {
    background: rgba(30, 77, 58, 0.05);
    transform: translateY(-1px);
  }
  
  .ksr-btn-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  
  /* Evidence bullets */
  .ksr-evidence-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  
  .ksr-evidence-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--ksr-border);
  }
  
  .ksr-evidence-list li:last-child {
    border-bottom: none;
  }
  
  .ksr-evidence-list li svg {
    flex-shrink: 0;
    color: var(--ksr-primary);
    margin-top: 2px;
  }
  
  /* Imaging cards */
  .ksr-imaging-option {
    background: var(--ksr-card-bg);
    border: 1px solid var(--ksr-border);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: center;
    transition: border-color 0.2s;
  }
  
  .ksr-imaging-option:hover {
    border-color: var(--ksr-primary);
  }
  
  .ksr-imaging-option svg {
    width: 48px;
    height: 48px;
    color: var(--ksr-primary);
    margin-bottom: 1rem;
  }
  
  .ksr-imaging-option h4 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--ksr-text);
  }
  
  .ksr-imaging-option p {
    font-size: 0.875rem;
    color: var(--ksr-text-muted);
    margin: 0 0 1rem;
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .knee-score-results-section {
      padding: 3rem 1rem;
    }
    
    .ksr-header h2 {
      font-size: 1.5rem;
    }
    
    .ksr-section-card {
      padding: 1.5rem;
    }
    
    .ksr-btn-group {
      flex-direction: column;
    }
    
    .ksr-btn {
      width: 100%;
    }
  }
</style>

<div class="ksr-container" id="{{ section.settings.section_id }}">
  <header class="ksr-header">
    <h2>{{ section.settings.section_title }}</h2>
    <p>{{ section.settings.section_description }}</p>
  </header>
  
  {% comment %} Shop Supplements Section {% endcomment %}
  {% if section.settings.show_shop_section %}
  <div class="ksr-anchor-section" id="shop-supplements">
    <div class="ksr-section-card">
      <h3>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        {{ section.settings.shop_title }}
      </h3>
      <p>Support your knee health with our clinician-formulated supplements, designed to work alongside your recovery plan.</p>
      
      {% if section.settings.shop_collection %}
        <div class="ksr-grid-3">
          {% for product in collections[section.settings.shop_collection].products limit: 3 %}
            <a href="{{ product.url }}" class="ksr-product-card">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}" loading="lazy">
              {% endif %}
              <div class="ksr-product-card-content">
                <h4>{{ product.title }}</h4>
                <span class="price">{{ product.price | money }}</span>
              </div>
            </a>
          {% endfor %}
        </div>
      {% endif %}
      
      <div class="ksr-btn-group" style="margin-top: 1.5rem;">
        <a href="{{ section.settings.shop_url | default: '/collections/joint-optimisation' }}" class="ksr-btn ksr-btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          Shop All Joint Support
        </a>
      </div>
    </div>
  </div>
  {% endif %}
  
  {% comment %} Evidence & Science Section {% endcomment %}
  {% if section.settings.show_evidence_section %}
  <div class="ksr-anchor-section" id="evidence-science">
    <div class="ksr-section-card">
      <h3>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18"/>
        </svg>
        {{ section.settings.evidence_title }}
      </h3>
      
      <div>{{ section.settings.evidence_content }}</div>
      
      <ul class="ksr-evidence-list">
        <li>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Recommendations based on peer-reviewed research and clinical guidelines</span>
        </li>
        <li>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Test packages tailored to your specific score band and health profile</span>
        </li>
        <li>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Developed by sports medicine specialists and orthopaedic consultants</span>
        </li>
      </ul>
      
      <div class="ksr-btn-group">
        <a href="{{ section.settings.science_page_url | default: '/pages/science' }}" class="ksr-btn ksr-btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
          </svg>
          Explore the Science
        </a>
        <a href="{{ section.settings.science_page_url | default: '/pages/science' }}#references" class="ksr-btn ksr-btn-secondary">
          View Research References
        </a>
      </div>
    </div>
  </div>
  {% endif %}
  
  {% comment %} Book Imaging Section {% endcomment %}
  {% if section.settings.show_imaging_section %}
  <div class="ksr-anchor-section" id="book-imaging">
    <div class="ksr-section-card">
      <h3>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <path d="M21 15l-5-5L5 21"/>
        </svg>
        {{ section.settings.imaging_title }}
      </h3>
      <p>{{ section.settings.imaging_description }}</p>
      
      <div class="ksr-grid-2">
        <div class="ksr-imaging-option">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="M21 15l-5-5L5 21"/>
          </svg>
          <h4>Knee Scan</h4>
          <p>MRI, ultrasound, or X-ray imaging with expert reporting</p>
          <a href="{{ section.settings.imaging_url | default: 'https://mykneescan.com' }}" class="ksr-btn ksr-btn-primary" target="_blank" rel="noopener noreferrer">
            Book at MyKneeScan
          </a>
        </div>
        
        <div class="ksr-imaging-option">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
          <h4>Clinician Review</h4>
          <p>One-on-one consultation to review your results and next steps</p>
          <a href="{{ section.settings.clinician_url | default: 'https://sportshealing.com' }}" class="ksr-btn ksr-btn-secondary" target="_blank" rel="noopener noreferrer">
            Book at Sportshealing
          </a>
        </div>
      </div>
    </div>
  </div>
  {% endif %}
</div>
